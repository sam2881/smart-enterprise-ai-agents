"""
APEX Pattern P04 (SP Variant): Legacy Stored Procedure Migration Pipeline
Generated by APEX Data Agent — LegacyMigrationAgent

Migrates {{ objects_extracted | default(0) }} stored procedures from
{{ extraction_source | default('LIVE_DB') }} to PySpark on Cloud Dataproc.

Migration Job ID: {{ job_id }}
DAG ID: {{ dag_id }}
Domain: {{ domain }}
Environment: {{ environment | default('dev') }}

Execution strategy:
  - Procedures are grouped by topological dependency level (topo_level 0 = leaves = deepest deps)
  - Each level runs as an Airflow TaskGroup
  - Within a level, all DataprocSubmitJobOperator tasks run in parallel
  - Levels run sequentially (level 0 → level 1 → level 2 → ...)
"""

import os
from datetime import datetime, timedelta

from airflow import DAG
from airflow.operators.empty import EmptyOperator
from airflow.utils.task_group import TaskGroup
from airflow.utils.trigger_rule import TriggerRule
from airflow.providers.google.cloud.operators.dataproc import DataprocSubmitJobOperator
from airflow.models import Variable

from dag_utilities.core import MetadataClient, APEXConfig
from dag_utilities.logging import AuditLogger


# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

DAG_ID = "{{ dag_id }}"
DOMAIN = "{{ domain }}"
ENVIRONMENT = os.getenv("APEX_ENVIRONMENT", "{{ environment | default('dev') }}")
MIGRATION_JOB_ID = "{{ job_id }}"

GCP_PROJECT = os.getenv("GCP_PROJECT", "{{ gcs_prefix | replace('gs://', '') | split('/') | first }}")
GCP_REGION = os.getenv("GCP_REGION", "us-central1")
DATAPROC_CLUSTER = Variable.get("dataproc_cluster", default_var="apex-migration-cluster")
GCS_BUCKET = Variable.get("gcs_staging_bucket", default_var="gs://apex-migrations")

config = APEXConfig.from_environment()
metadata = MetadataClient(config.metadata_db_url)
audit = AuditLogger(metadata)


# ═══════════════════════════════════════════════════════════════════════════════
# EXECUTION BATCHES  (topo_level → [proc_fqn, ...])
# ═══════════════════════════════════════════════════════════════════════════════

SP_EXECUTION_BATCHES = {
{% for level, procs in sp_execution_batches.items() %}
    {{ level }}: {{ procs | tojson }},
{% endfor %}
}

SP_EXECUTION_ORDER = {{ sp_execution_order | tojson }}

STORED_PROCS = {
{% for proc in stored_procs %}
    "{{ proc.id }}": {
        "schema": "{{ proc.schema }}",
        "name": "{{ proc.name }}",
        "object_type": "{{ proc.object_type }}",
        "topo_level": {{ proc.topo_level }},
        "param_count": {{ proc.param_count }},
        "char_count": {{ proc.char_count }},
    },
{% endfor %}
}


# ═══════════════════════════════════════════════════════════════════════════════
# HELPER — Build Dataproc pyspark_job payload for one stored procedure
# ═══════════════════════════════════════════════════════════════════════════════

def _build_sp_job(proc_fqn: str, level: int) -> dict:
    """Build the Dataproc job dict for one SP migration PySpark script."""
    safe_name = proc_fqn.replace(".", "__").lower()
    return {
        "reference": {"project_id": GCP_PROJECT},
        "placement": {"cluster_name": DATAPROC_CLUSTER},
        "pyspark_job": {
            "main_python_file_uri": (
                f"{GCS_BUCKET}/migration/{MIGRATION_JOB_ID}/"
                f"{safe_name}.py"
            ),
            "args": [
                f"--migration_job_id={MIGRATION_JOB_ID}",
                f"--proc_fqn={proc_fqn}",
                f"--topo_level={level}",
                f"--environment={ENVIRONMENT}",
            ],
            "properties": {
                "spark.migration.gcp_project": GCP_PROJECT,
                "spark.migration.environment": ENVIRONMENT,
            },
        },
    }


# ═══════════════════════════════════════════════════════════════════════════════
# DAG DEFAULT ARGS
# ═══════════════════════════════════════════════════════════════════════════════

default_args = {
    "owner": "apex-data-agent",
    "depends_on_past": False,
    "email_on_failure": {{ notification_emails | default([]) | length > 0 | lower }},
    "email_on_retry": False,
    "email": {{ notification_emails | default([]) | tojson }},
    "retries": {{ retry_count | default(2) }},
    "retry_delay": timedelta(minutes=5),
    "execution_timeout": timedelta(hours=4),
}


# ═══════════════════════════════════════════════════════════════════════════════
# DAG DEFINITION
# ═══════════════════════════════════════════════════════════════════════════════

with DAG(
    dag_id=DAG_ID,
    description="Legacy SP migration — {{ objects_extracted | default(0) }} procedures via {{ extraction_source | default('LIVE_DB') }}",
    schedule_interval="{{ schedule_interval | default('@once') }}",
    start_date=datetime({{ start_date.year }}, {{ start_date.month }}, {{ start_date.day }}),
    catchup=False,
    max_active_runs=1,
    default_args=default_args,
    tags=["migration", "legacy", "p04", "{{ domain }}", "{{ environment | default('dev') }}"],
) as dag:

    start = EmptyOperator(task_id="start_migration")
    end = EmptyOperator(task_id="end_migration", trigger_rule=TriggerRule.NONE_FAILED_MIN_ONE_SUCCESS)

    # ── Topological level groups ──────────────────────────────────────────────
    #
    # Level 0 = leaf procedures (no outgoing calls) — run first.
    # Level N = procedures that call level N-1 — run after level N-1 finishes.
    #
{% set levels = sp_execution_batches.keys() | list | sort %}
{% if levels %}
    # Level pointers for chaining
    _prev_level_tasks = [start]

{% for level in levels %}
{% set procs = sp_execution_batches[level] %}
    # ─── Level {{ level }} ({{ procs | length }} procedure(s)) ──────────────
    with TaskGroup(group_id="sp_batch_level_{{ level }}") as level_{{ level }}_group:
{% for fqn in procs %}
{% set safe = fqn | replace(".", "__") | lower %}
        migrate_{{ safe }} = DataprocSubmitJobOperator(
            task_id="migrate_{{ safe }}",
            job=_build_sp_job("{{ fqn }}", {{ level }}),
            region=GCP_REGION,
            project_id=GCP_PROJECT,
        )
{% endfor %}

    # Chain: previous level → current level group
    for _t in _prev_level_tasks:
        _t >> level_{{ level }}_group
    _prev_level_tasks = [level_{{ level }}_group]

{% endfor %}
    # Chain last level group → end
    for _t in _prev_level_tasks:
        _t >> end

{% else %}
    # No stored procedures were extracted — DAG is a no-op skeleton
    start >> end
{% endif %}
