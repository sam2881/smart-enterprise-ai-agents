with DAG(
    dag_id=DAG_ID,
    schedule_interval=dag_interval,
    catchup=False,
    is_paused_upon_creation=True,
    default_args=default_args,
    template_searchpath=["/opt/cornerstone/repo/"],
    tags=["apex", "p01_file_group", DOMAIN, ENVIRONMENT],
    params={"reporting_date_manual": ""},
    on_failure_callback=partial(dag_group_failure,
                                feed_group_id=FEED_GROUP_ID, pg_conn_info_dict=pg_conn_info,
                                dag_id=DAG_ID, environment=ENVIRONMENT,
                                primary_feed_id={{ feeds[0].feed_id if feeds else 0 }}),
    doc_md=DOC_MD,
) as dag:

    # ── Start: Load connection info (production pattern) ──
    start = PythonOperator(
        task_id="Start",
        python_callable=load_conn_info,
        op_kwargs={
{% if use_samba | default(false) %}
            "samba_conn_id": SAMBA_CONN_ID,
{% endif %}
        },
    )

    end = EmptyOperator(task_id="end", trigger_rule=TriggerRule.NONE_FAILED)

{% if check_business_date | default(false) %}
    is_posting_date = BranchPythonOperator(
        task_id="is_posting_date",
        python_callable=dag_is_posting_date,
        op_kwargs={
            "pg_conn_info_dict": pg_conn_info,
            "calendar_name": "{{ business_calendar | default('default') }}",
        },
    )
{% endif %}

    # ── Group Init ──
    group_init = PythonOperator(
        task_id="group_init",
        python_callable=dag_group_init,
        op_kwargs={
            "feed_group_id": FEED_GROUP_ID,
            "pg_conn_info_dict": pg_conn_info,
            "feed_count": {{ feeds | length }},
        },
    )

    # ── Group Audit ──
    group_audit_task = PythonOperator(
        task_id="group_audit",
        python_callable=dag_group_audit,
        op_kwargs={
            "feed_group_id": FEED_GROUP_ID,
            "pg_conn_info_dict": pg_conn_info,
            "feed_count": {{ feeds | length }},
        },
    )

    # ── Per-Feed Nested TaskGroups ──
    feed_task_groups = []

{% for feed in feeds %}
    with TaskGroup(group_id="feed_{{ feed.feed_id }}") as feed_tg_{{ feed.feed_id }}:

        feed_init_{{ feed.feed_id }} = PythonOperator(
            task_id="init",
            python_callable=dag_init,
            op_kwargs={"feed_id": {{ feed.feed_id }}, "pg_conn_info_dict": pg_conn_info},
        )

        feed_s2t_{{ feed.feed_id }} = PythonOperator(
            task_id="source_to_transient",
            python_callable=dag_source_to_transient,
            op_kwargs={"feed_id": {{ feed.feed_id }}, "pg_conn_info_dict": pg_conn_info},
            executor_config=get_pod_template_cstonedfs(executor_config=None),
        )

        schema_val_{{ feed.feed_id }} = get_spark_tg_wrapper_v2(
            dag_name=dag,
            tg_name="schema_validation",
            feed_name="feed_{{ feed.feed_id }}.",
            spark_app_name=str({{ feed.feed_id }}) + "-schema-" + str(uuid.uuid4()),
            spark_app_file_name=PYSPARK_SCRIPT_PATH + "common/great_expectations/ge_schema_validator.py",
            exec_size="{{ exec_size | default('medium') }}",
            extra_task_id="check_result",
            extra_func=check_ge_status,
            extra_args={
                "feed_id": {{ feed.feed_id }},
                "conn_id": POSTGRES_CONN_ID,
                "success_branch": "feed_{{ feed.feed_id }}.raw_to_refine.combined-spark",
                "fail_branch": "feed_{{ feed.feed_id }}.transient_to_rejected",
            },
            spark_args=[
                str({{ feed.feed_id }}),
                "{{ '{{ run_id }}' }}",
                "",
                pg_conn_info["pg_host"],
                pg_conn_info["pg_schema"],
                pg_conn_info["pg_user"],
                pg_conn_info["pg_pw"],
                pg_conn_info["pg_port"],
                pg_conn_info.get("pg_extra", ""),
            ],
        )

        raw_to_refine_{{ feed.feed_id }} = get_spark_tg_wrapper_v2(
            dag_name=dag,
            tg_name="raw_to_refine",
            feed_name="feed_{{ feed.feed_id }}.",
            spark_app_name=str({{ feed.feed_id }}) + "-refined-" + str(uuid.uuid4()),
            spark_app_file_name=PYSPARK_SCRIPT_PATH + "common/raw_to_refine_v2.py",
            exec_size="{{ exec_size | default('medium') }}",
            spark_args=[
                pg_conn_info["pg_host"],
                pg_conn_info["pg_schema"],
                pg_conn_info["pg_user"],
                pg_conn_info["pg_pw"],
                pg_conn_info["pg_port"],
                pg_conn_info.get("pg_extra", ""),
                str({{ feed.feed_id }}),
            ],
        )

        refine_to_trusted_{{ feed.feed_id }} = get_spark_tg_wrapper_v2(
            dag_name=dag,
            tg_name="refine_to_trusted",
            feed_name="feed_{{ feed.feed_id }}.",
            spark_app_name=str({{ feed.feed_id }}) + "-trusted-" + str(uuid.uuid4()),
            spark_app_file_name=PYSPARK_SCRIPT_PATH + "common/refine_to_trusted.py",
            exec_size="{{ exec_size | default('medium') }}",
            spark_args=[
                pg_conn_info["pg_host"],
                pg_conn_info["pg_schema"],
                pg_conn_info["pg_user"],
                pg_conn_info["pg_pw"],
                pg_conn_info["pg_port"],
                pg_conn_info.get("pg_extra", ""),
                str({{ feed.feed_id }}),
            ],
        )

{% if feed.include_consumption | default(false) %}
        cz_tg_{{ feed.feed_id }} = get_spark_tg_wrapper_v2(
            dag_name=dag,
            tg_name="consumption_zone",
            feed_name="feed_{{ feed.feed_id }}.",
            spark_app_name=str({{ feed.feed_id }}) + "-cz-" + str(uuid.uuid4()),
            spark_app_file_name=PYSPARK_SCRIPT_PATH + "common/consumption_zone_pyspark_scripts/"
                + "{{ feed.consumption_script | default('consumption_zone.py') }}",
            exec_size="{{ exec_size | default('large') }}",
            spark_args=[
                pg_conn_info["pg_host"],
                pg_conn_info["pg_schema"],
                pg_conn_info["pg_user"],
                pg_conn_info["pg_pw"],
                pg_conn_info["pg_port"],
                pg_conn_info.get("pg_extra", ""),
                str({{ feed.feed_id }}),
            ],
        )
{% endif %}

        feed_archive_{{ feed.feed_id }} = PythonOperator(
            task_id="archive",
            python_callable=dag_archive,
            op_kwargs={"feed_id": {{ feed.feed_id }}, "pg_conn_info_dict": pg_conn_info},
        )

        feed_audit_{{ feed.feed_id }} = PythonOperator(
            task_id="audit",
            python_callable=dag_final_audit,
            op_kwargs={"feed_id": {{ feed.feed_id }}, "pg_conn_info_dict": pg_conn_info},
        )

        # Feed-level task dependencies
        feed_init_{{ feed.feed_id }} >> feed_s2t_{{ feed.feed_id }}
        feed_s2t_{{ feed.feed_id }} >> schema_val_{{ feed.feed_id }} >> raw_to_refine_{{ feed.feed_id }} >> refine_to_trusted_{{ feed.feed_id }}
{% if feed.include_consumption | default(false) %}
        refine_to_trusted_{{ feed.feed_id }} >> cz_tg_{{ feed.feed_id }} >> feed_archive_{{ feed.feed_id }}
{% else %}
        refine_to_trusted_{{ feed.feed_id }} >> feed_archive_{{ feed.feed_id }}
{% endif %}
        feed_archive_{{ feed.feed_id }} >> feed_audit_{{ feed.feed_id }}

    feed_task_groups.append(feed_tg_{{ feed.feed_id }})
{% endfor %}

    # ── File Remaining + Re-trigger (production pattern) ──
    is_file_remaining_task = BranchPythonOperator(
        task_id="is_file_remaining",
        python_callable=dag_check_remaining,
        op_kwargs={"feed_id": {{ feeds[0].feed_id if feeds else 0 }}, "pg_conn_info_dict": pg_conn_info},
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    trigger_dag = TriggerDagRunOperator(
        task_id="trigger_dag",
        trigger_dag_id=DAG_ID,
        execution_date="{{ '{{ dag_run.execution_date + macros.timedelta(minutes=1) }}' }}",
        conf={"is_email_file_count": 0},
    )

    # ═══════════════════════════════════════════════════════════════════════════
    # GROUP-LEVEL TASK DEPENDENCIES (production flow pattern)
    # ═══════════════════════════════════════════════════════════════════════════

{% if check_business_date | default(false) %}
    start >> is_posting_date >> [group_init, end]
{% else %}
    start >> group_init
{% endif %}

    for ftg in feed_task_groups:
        group_init >> ftg >> group_audit_task

    group_audit_task >> is_file_remaining_task
    is_file_remaining_task >> [trigger_dag, end]
    trigger_dag >> end
