        python_callable=dag_source_to_transient,
        op_kwargs=_BASE_KWARGS,
        executor_config=get_pod_template_cstonedfs(executor_config=None),
{% if enable_lineage | default(false) %}
        inlets=[OMEntity(entity=Container, fqn="{{ source_lineage_fqn | default('') }}")] if _HAS_OM else [],
        outlets=[OMEntity(entity=Container, fqn="{{ transient_lineage_fqn | default('') }}")] if _HAS_OM else [],
{% endif %}
    )

    # ── Get Schema Version (production pattern) ──
    get_schema_version = PythonOperator(
        task_id="get_file_schema_version",
        python_callable=get_schema_version5,
        op_kwargs={
            **_BASE_KWARGS,
            "zone": "raw",
        },
    )

    # ── Zone Processing: Spark TaskGroups with GE branching ──
    with TaskGroup(group_id="{{ feed_task_group_name | default('feed_load') }}") as feed_load:
        get_run_id = PythonOperator(
            task_id="get_run_id",
            python_callable=get_file_run_id,
            op_kwargs=_BASE_KWARGS,
        )

        schema_validation = get_spark_tg_wrapper_v2(
            dag_name=dag,
            tg_name="schema_validation",
            feed_name="{{ feed_task_group_name | default('feed_load') }}.",
            spark_app_name=str(FEED_ID) + "-schema-" + str(uuid.uuid4()),
            spark_app_file_name=PYSPARK_SCRIPT_PATH + "common/great_expectations/ge_schema_validator.py",
            exec_size="{{ exec_size | default('medium') }}",
            extra_task_id="check_result",
            extra_func=check_ge_status,
            extra_args={
                "feed_id": FEED_ID,
                "batch_id": "{{ '{{ run_id }}' }}",
                "conn_id": POSTGRES_CONN_ID,
                "success_branch": "{{ feed_task_group_name | default('feed_load') }}.transient_to_raw",
                "fail_branch": "{{ feed_task_group_name | default('feed_load') }}.transient_to_rejected",
            },
            spark_args=[
                str(FEED_ID),
                "{{ '{{ run_id }}' }}",
                '{{ "{{" }}ti.xcom_pull(key="data_asset_name", task_ids="get_file_schema_version"){{ "}}" }}',
                pg_conn_info["pg_host"],
                pg_conn_info["pg_schema"],
                pg_conn_info["pg_user"],
                pg_conn_info["pg_pw"],
                pg_conn_info["pg_port"],
                pg_conn_info.get("pg_extra", ""),
                '{{ "{{" }}ti.xcom_pull(key="run_id_cws", task_ids="init"){{ "}}" }}',
                "{{ validations_s3_prefix | default('cdls/validations/great_expectations/') }}",
                "{{ data_docs_prefix | default('cdls/data_docs/great_expectations/') }}",
                FILE_FORMAT,
                HEADER_DETAILS,
                RAW_VALIDATION_TYPE,
                RAW_CHECKPOINT_NAME,
            ],
            executor_config=get_pod_template_cstonedfs(executor_config=None),
        )

        raw_to_refine = get_spark_tg_wrapper_v2(
            dag_name=dag,
            tg_name="raw_to_refine",
            feed_name="{{ feed_task_group_name | default('feed_load') }}.",
            spark_app_name=str(FEED_ID) + "-refined-" + str(uuid.uuid4()),
            spark_app_file_name=PYSPARK_SCRIPT_PATH + "common/raw_to_refine_v2.py",
            exec_size="{{ exec_size | default('medium') }}",
            spark_args=[
                pg_conn_info["pg_host"],
                pg_conn_info["pg_schema"],
                pg_conn_info["pg_user"],
                pg_conn_info["pg_pw"],
                pg_conn_info["pg_port"],
                pg_conn_info.get("pg_extra", ""),
                "{{ raw_schema_name | default('cstone_native') }}",
                "{{ refined_schema_name | default('cstone_refined') }}",
                "{{ table_name | default('') }}",
                "{{ '{{ dag_run.start_date }}' }}",
                str(FEED_ID),
                '{{ "{{" }}ti.xcom_pull(key="run_id", task_ids="init"){{ "}}" }}',
                "",
                "",
                HEADER_DETAILS,
                '{{ "{{" }}ti.xcom_pull(key="schema_version", task_ids="get_file_schema_version"){{ "}}" }}',
                FOOTER_DETAILS,
                '{{ "{{" }}ti.xcom_pull(key="feed_group_uuid_id", task_ids="init"){{ "}}" }}',
                RAW_PATH,
                FILE_FORMAT,
                COLUMN_DELIMITER,
            ],
        )

{% if enable_trusted_validation | default(true) %}
        is_trusted_validation = BranchPythonOperator(
            task_id="is_trusted_validation",
            python_callable=check_flag,
            op_kwargs={
                **_BASE_KWARGS,
                "flag_name": "is_trusted_validation",
            },
        )
        not_trusted_validation = EmptyOperator(task_id="not_trusted_validation")

        semantic_validation_trusted = get_spark_tg_wrapper_v2(
            dag_name=dag,
            tg_name="semantic_validation_trusted",
            feed_name="{{ feed_task_group_name | default('feed_load') }}.",
            spark_app_name=str(FEED_ID) + "-trusted-ge-" + str(uuid.uuid4()),
            spark_app_file_name=PYSPARK_SCRIPT_PATH + "common/semantic_validator_trusted.py",
            exec_size="{{ exec_size | default('medium') }}",
            extra_task_id="check_result",
            extra_func=check_trusted_ge_status,
            extra_args={
                "feed_id": FEED_ID,
                "conn_id": POSTGRES_CONN_ID,
                "success_branch": "{{ feed_task_group_name | default('feed_load') }}.refine_to_trusted.combined-spark",
                "fail_branch": "{{ feed_task_group_name | default('feed_load') }}.trusted_rejected_audit_log",
                "email_to": email_recipient,
            },
            spark_args=[
                pg_conn_info["pg_host"],
                pg_conn_info["pg_schema"],
                pg_conn_info["pg_user"],
                pg_conn_info["pg_pw"],
                pg_conn_info["pg_port"],
                pg_conn_info.get("pg_extra", ""),
                str(FEED_ID),
                TRUSTED_VALIDATION_TYPE,
            ],
        )
{% endif %}

        refine_to_trusted = get_spark_tg_wrapper_v2(
            dag_name=dag,
            tg_name="refine_to_trusted",
            feed_name="{{ feed_task_group_name | default('feed_load') }}.",
            spark_app_name=str(FEED_ID) + "-trusted-" + str(uuid.uuid4()),
            spark_app_file_name=PYSPARK_SCRIPT_PATH + "common/refine_to_trusted.py",
            exec_size="{{ exec_size | default('medium') }}",
            extra_task_id="get_reporting_date_for_cz",
            extra_func=get_reporting_date_for_cz,
            extra_args={
                "feed_id": FEED_ID,
{% if use_trino | default(false) %}
                "trino_conn_id": TRINO_CONN_ID,
{% endif %}
                "trusted_schema_name": "{{ trusted_schema_name | default('cstone_trusted') }}",
                "trusted_table_name": "{{ trusted_table_name | default('') }}",
                "success_branch": "{{ feed_task_group_name | default('feed_load') }}.get_feed_target_details",
                "fail_branch": "check_duplicate_file",
            },
            spark_args=[
                pg_conn_info["pg_host"],
                pg_conn_info["pg_schema"],
                pg_conn_info["pg_user"],
                pg_conn_info["pg_pw"],
                pg_conn_info["pg_port"],
                pg_conn_info.get("pg_extra", ""),
                "{{ refined_schema_name | default('cstone_refined') }}",
                "{{ trusted_schema_name | default('cstone_trusted') }}",
                "{{ table_name | default('') }}",
                str(FEED_ID),
            ],
        )

{% if include_consumption | default(false) %}
        get_feed_target = PythonOperator(
            task_id="get_feed_target_details",
            python_callable=get_target_details,
            op_kwargs={
                **_BASE_KWARGS,
                "conn_id": POSTGRES_CONN_ID,
            },
        )
{% endif %}

{% if enable_rejection_workflow | default(false) %}
        transient_to_rejected = PythonOperator(
            task_id="transient_to_rejected",
            python_callable=move_s3_multiple_objects,
            op_kwargs={
                "source_path": "{{ s3_transient_path | default('') }}",
                "dest_path": REJECTED_PATH,
                "BUCKET_NAME": BUCKET_NAME,
            },
{% if enable_lineage | default(false) %}
            inlets=[OMEntity(entity=Container, fqn="{{ transient_lineage_fqn | default('') }}")] if _HAS_OM else [],
            outlets=[OMEntity(entity=Container, fqn="{{ rejected_lineage_fqn | default('') }}")] if _HAS_OM else [],
{% endif %}
        )

        rejected_audit = PythonOperator(
            task_id="rejected_audit_log",
            python_callable=audit_log,
            op_kwargs={
                **_BASE_KWARGS,
                "file_run_id": 0,
                "status": "rejected",
                "zone": "rejected",
            },
        )

        trusted_rejected_audit = PythonOperator(
            task_id="trusted_rejected_audit_log",
            python_callable=audit_log,
            op_kwargs={
                **_BASE_KWARGS,
                "file_run_id": 0,
                "status": "trusted_rejected",
                "zone": "trusted",
            },
        )
{% endif %}

        # ── Feed TaskGroup internal dependencies ──
        get_run_id >> schema_validation >> raw_to_refine
{% if enable_trusted_validation | default(true) %}
        raw_to_refine >> is_trusted_validation
        is_trusted_validation >> semantic_validation_trusted >> refine_to_trusted
        is_trusted_validation >> not_trusted_validation >> refine_to_trusted
{% else %}
        raw_to_refine >> refine_to_trusted
{% endif %}
{% if include_consumption | default(false) %}
        refine_to_trusted >> get_feed_target
{% endif %}

    # ── Duplicate File Check (production pattern) ──
    check_duplicate_file = BranchPythonOperator(
        task_id="check_duplicate_file",
        python_callable=check_dup_file,
        op_kwargs={
            **_BASE_KWARGS,
        },
        trigger_rule=TriggerRule.NONE_FAILED_MIN_ONE_SUCCESS,
    )

    move_duplicate = PythonOperator(
        task_id="move_duplicate",
        python_callable=move_if_duplicate_Dir,
        op_kwargs=_BASE_KWARGS,
    )
    not_duplicate = EmptyOperator(task_id="not_duplicate")

    # ── Archive, Audit, Re-trigger ──
    archive_task = PythonOperator(
        task_id="archive",
        python_callable=dag_archive,
        op_kwargs=_BASE_KWARGS,
    )
    final_audit = PythonOperator(
        task_id="final_audit",
        python_callable=dag_final_audit,
        op_kwargs=_BASE_KWARGS,
    )

    is_file_remaining_task = BranchPythonOperator(
        task_id="is_file_remaining",
        python_callable=dag_check_remaining,
        op_kwargs=_BASE_KWARGS,
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    trigger_dag = TriggerDagRunOperator(
        task_id="trigger_dag",
        trigger_dag_id=DAG_ID,
        execution_date="{{ '{{ dag_run.execution_date + macros.timedelta(minutes=1) }}' }}",
        conf={"is_email_file_count": 0},
    )

    # ═══════════════════════════════════════════════════════════════════════════
    # TASK DEPENDENCIES (production flow pattern)
    # ═══════════════════════════════════════════════════════════════════════════

{% if check_business_date | default(false) %}
    start >> is_posting_date
{% if use_samba_sensor | default(false) %}
    is_posting_date >> [samba_file_sensor, end]
    samba_file_sensor >> [file_not_found, email_if_multiple_file_count]
    email_if_multiple_file_count >> source_to_transient_task
{% elif use_file_sensor | default(false) %}
    is_posting_date >> [file_sensor, end]
    file_sensor >> source_to_transient_task
{% else %}
    is_posting_date >> [init, end]
{% endif %}
{% else %}
{% if use_file_sensor | default(false) %}
    start >> file_sensor >> init
{% else %}
    start >> init
{% endif %}
{% endif %}

{% if not check_business_date | default(false) %}
    init >> dup_check
    dup_check >> source_to_transient_task
    dup_check >> dup_skip >> end
{% endif %}

    source_to_transient_task >> get_schema_version >> feed_load

    feed_load >> check_duplicate_file
    check_duplicate_file >> [move_duplicate, not_duplicate]
    move_duplicate >> end
    not_duplicate >> archive_task

    archive_task >> final_audit >> is_file_remaining_task
    is_file_remaining_task >> [trigger_dag, end]
    trigger_dag >> end
    file_not_found >> end
