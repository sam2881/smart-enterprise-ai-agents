    params={"reporting_date_manual": ""},
    on_failure_callback=partial(dag_handle_failure,
                                feed_id=FEED_ID, pg_conn_info_dict=pg_conn_info,
                                dag_id=DAG_ID, environment=ENVIRONMENT),
    doc_md=DOC_MD,
) as dag:

    # ── Start: Load connection info (production pattern) ──
    start = PythonOperator(
        task_id="Start",
        python_callable=load_conn_info,
        op_kwargs={
{% if use_samba | default(false) %}
            "samba_conn_id": SAMBA_CONN_ID,
{% endif %}
        },
    )

    end = EmptyOperator(task_id="end", trigger_rule=TriggerRule.NONE_FAILED)

{% if check_business_date | default(false) %}
    # ── Business Date Check (production pattern: BranchPythonOperator) ──
    is_posting_date = BranchPythonOperator(
        task_id="is_posting_date",
        python_callable=dag_is_posting_date,
        op_kwargs={
            "pg_conn_info_dict": pg_conn_info,
            "calendar_name": "{{ business_calendar | default('default') }}",
            "proceed_task_id": "{% if use_samba_sensor | default(false) %}samba_file_sensor.waiting_for_file{% elif use_file_sensor | default(false) %}wait_for_file{% else %}init{% endif %}",
            "skip_task_id": "end",
        },
    )
{% endif %}

{% if use_samba_sensor | default(false) %}
    # ── Samba File Sensor TaskGroup (production pattern) ──
    samba_file_sensor = get_samba_unlock_file_sensor_tg(
        dag=dag,
        tg_name="samba_file_sensor",
        samba_conn_id=SAMBA_CONN_ID,
        file_path="{{ source_path | default('') }}",
        file_mask=FILE_NAME_PATTERN,
        on_success_task="email_if_multiple_file_count",
        on_failure_task="file_not_found",
        poke_interval_in_sec={{ poke_interval_in_sec | default(1200) }},
        timeout_in_min={{ timeout_in_min | default(240) }},
        soft_fail=False,
        email_to=email_recipient,
    )
{% elif use_file_sensor | default(false) %}
    # ── GCS File Sensor (production pattern) ──
    file_sensor = GCSObjectExistenceSensor(
        task_id="wait_for_file",
        bucket="{{ source_bucket | default('apex-source') }}",
        object="{{ source_object_prefix | default('') }}",
        timeout={{ file_sensor_timeout | default(3600) }},
        poke_interval={{ file_sensor_poke_interval | default(300) }},
        mode="poke",
    )
{% endif %}

    # ── Notifications (production pattern) ──
    file_not_found = PythonOperator(
        task_id="file_not_found",
        python_callable=send_notification,
        op_kwargs={
            **_BASE_KWARGS,
            "status": "file_not_found",
            "recipients": email_recipient,
            "message": "No file found for {{ dag_id }}",
        },
    )

    email_if_multiple_file_count = PythonOperator(
