# ═══════════════════════════════════════════════════════════════════════════════
# STEP 1: VALIDATE METADATA COMPLETENESS (Fail Fast)
# ═══════════════════════════════════════════════════════════════════════════════

def validate_metadata_completeness(**context) -> Dict[str, Any]:
    """
    STEP 1: Validate metadata completeness before any artifact generation.

    FAIL FAST if:
    - Feed definition missing or invalid
    - Contract correctness fails (SCD2, Data Vault, Star Schema)
    - Schema versioning issues
    - Validation coverage gaps (GE rules not defined)
    - Target configuration incomplete
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)

    audit.log_event(
        "METADATA_VALIDATION_STARTED",
        feed_id=FEED_ID,
        execution_id=exec_ctx.execution_id,
    )

    # Run comprehensive metadata validation
    report = validator.validate_feed(FEED_ID)

    if not report.valid:
        error_messages = [e.message for e in report.errors]
        audit.log_event(
            "METADATA_VALIDATION_FAILED",
            feed_id=FEED_ID,
            errors=error_messages,
            severity="ERROR",
        )
        raise ValueError(f"Metadata validation failed: {'; '.join(error_messages)}")

    # Log warnings if any
    if report.warnings:
        for warning in report.warnings:
            audit.log_event(
                "METADATA_VALIDATION_WARNING",
                feed_id=FEED_ID,
                warning=warning.message,
            )

    audit.log_event(
        "METADATA_VALIDATION_PASSED",
        feed_id=FEED_ID,
        warning_count=len(report.warnings),
    )

    return report.to_dict()


# ═══════════════════════════════════════════════════════════════════════════════
# STEP 3: BUILD RESOLVED EXECUTION PLAN (Immutable)
# ═══════════════════════════════════════════════════════════════════════════════

def build_execution_plan(**context) -> Dict[str, Any]:
    """
    STEP 3: Build immutable execution plan with checksum.

    The execution plan DRIVES all downstream execution:
    - source_type, source_category
    - zones to process
    - validations per zone
    - load_mode, delete_mode
    - contract_type, data_vault_type
    - encryption configuration
    - target settings
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)

    audit.log_event(
        "EXECUTION_PLAN_BUILDING",
        feed_id=FEED_ID,
        execution_id=exec_ctx.execution_id,
    )

    # Build deterministic execution plan
    plan = plan_builder.build(
        feed_id=FEED_ID,
        batch_id=exec_ctx.batch_id,
    )

    # Verify checksum for determinism
    if not plan_builder.verify_checksum(plan):
        raise ValueError("Execution plan checksum verification failed - non-deterministic output detected")

    # Persist plan for audit trail and data plane access
    metadata.save_execution_plan(exec_ctx.execution_id, plan.to_dict())

    audit.log_event(
        "EXECUTION_PLAN_BUILT",
        feed_id=FEED_ID,
        plan_id=plan.plan_id,
        checksum=plan.checksum,
        zone_count=len(plan.zones),
    )

    return plan.to_dict()


# ═══════════════════════════════════════════════════════════════════════════════
# STEP 4-6: ZONE PROCESSING (Uniform Pattern for All Zones)
# ═══════════════════════════════════════════════════════════════════════════════

def process_zone(zone: str, **context) -> Dict[str, Any]:
    """
    Process a single zone using the generic zone_processor.py Spark job.

    UNIFORM 7-STEP PATTERN (same for ALL zones):
    1. Read Metadata      → MetadataClient.get_zone_config(feed_id, zone)
    2. Read Source        → SparkSession.read from previous zone/source
    3. GE Schema Validate → validate_schema(df, schema_expectation_suite)
    4. Transform          → Apply zone-specific transforms from metadata
    5. GE Semantic Valid  → validate_semantic(df, semantic_rules)
    6. Write Target       → df.write with partition/clustering from metadata
    7. Update Lineage     → Record zone metrics in feed_ingestion_details

    Spark behavior changes ONLY via metadata, never code edits.
    """
    ti = context["ti"]
    exec_ctx = ExecutionContext.from_airflow_context(context)
    execution_plan = ti.xcom_pull(task_ids="build_execution_plan")

    audit.log_event(
        "ZONE_PROCESSING_STARTED",
        feed_id=FEED_ID,
        zone=zone,
        execution_id=exec_ctx.execution_id,
    )

    # Submit Dataproc job with zone_processor.py (generic for ALL zones)
    result = submit_zone_job(
        feed_id=FEED_ID,
        zone=zone,
        batch_id=exec_ctx.batch_id,
        metadata_url=config.metadata_db_url,
        gcp_project=GCP_PROJECT,
        gcp_region=GCP_REGION,
        dataproc_cluster=DATAPROC_CLUSTER,
        spark_jobs_bucket=SPARK_JOBS_BUCKET,
    )

    audit.log_event(
        "ZONE_PROCESSING_COMPLETED",
        feed_id=FEED_ID,
        zone=zone,
        records_processed=result.get("records_processed", 0),
    )

    return result


def validate_zone(zone: str, **context) -> Dict[str, Any]:
    """
    Run Great Expectations validation after zone processing.

    GE rules come from quality_rules metadata table:
    - NO inline expectations in code
    - Auto-create expectation suites if not exist
    - Results written back to PostgreSQL
    - Branching controlled by Control Plane
    """
    ti = context["ti"]
    exec_ctx = ExecutionContext.from_airflow_context(context)
    execution_plan = ti.xcom_pull(task_ids="build_execution_plan")

    # Get zone-specific validation rules from execution plan
    zone_plan = next(
        (z for z in execution_plan.get("zones", []) if z.get("zone_level") == zone),
        {}
    )

    if not zone_plan.get("validations", {}).get("semantic", False):
        audit.log_event(
            "GE_VALIDATION_SKIPPED",
            feed_id=FEED_ID,
            zone=zone,
            reason="Semantic validation disabled for zone",
        )
        return {"status": "skipped", "zone": zone}

    # Run GE validation (auto-creates suite from metadata if missing)
    result = ge_validator.validate_zone(
        feed_id=FEED_ID,
        zone=zone,
        batch_id=exec_ctx.batch_id,
    )

    # Check quality threshold
    quality_threshold = {{ quality_threshold | default(0.95) }}
    if result.success_rate < quality_threshold:
        audit.log_event(
            "GE_VALIDATION_FAILED",
            feed_id=FEED_ID,
            zone=zone,
            success_rate=result.success_rate,
            threshold=quality_threshold,
        )

        {% if ge_failure_policy | default('FAIL') == 'FAIL' %}
        raise ValueError(
            f"GE validation failed in {zone}: {result.success_rate:.2%} < {quality_threshold:.2%}"
        )
        {% else %}
        return {"status": "warning", "zone": zone, "success_rate": result.success_rate}
        {% endif %}

    audit.log_event(
        "GE_VALIDATION_PASSED",
        feed_id=FEED_ID,
        zone=zone,
        success_rate=result.success_rate,
    )

    return {"status": "success", "zone": zone, "success_rate": result.success_rate}


# ═══════════════════════════════════════════════════════════════════════════════
# SOURCE CHECKING (Override in child templates)
# ═══════════════════════════════════════════════════════════════════════════════

{% block source_check_function %}
def check_source_available(**context) -> str:
    """
    Check if source data is available for processing.
    Override in child templates for source-specific logic.

    Returns:
        Task ID to branch to ("proceed_processing" or "skip_no_data")
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)

    # Default implementation - always proceed
    # Override in child templates for FILE, DATABASE, STREAMING, etc.
    audit.log_event(
        "SOURCE_CHECK_PASSED",
