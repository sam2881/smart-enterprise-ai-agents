# ═══════════════════════════════════════════════════════════════════════════════
# CONTRACT GATE (Fail Fast Before Ingestion)
# ═══════════════════════════════════════════════════════════════════════════════

def check_contract_gate(**context) -> str:
    """
    CONTRACT GATE: Validate producer contract BEFORE ingestion.

    Fail Fast Policy (default):
    - Schema drift detected → FAIL immediately
    - Missing required columns → FAIL
    - Type changes detected → FAIL (unless schema_evolution_mode = 'evolve')
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    ti = context["ti"]
    execution_plan = ti.xcom_pull(task_ids="build_execution_plan")

    result = contract_gate.validate_contract(
        feed_id=FEED_ID,
        execution_plan=execution_plan,
        policy="{{ contract_policy | default('FAIL_FAST') }}",
    )

    if not result.is_valid:
        audit.log_event(
            "CONTRACT_GATE_FAILED",
            feed_id=FEED_ID,
            violations=result.violations,
        )

        {% if contract_policy | default('FAIL_FAST') == 'FAIL_FAST' %}
        raise ValueError(f"Contract validation failed: {result.violations}")
        {% else %}
        return "skip_contract_failed"
        {% endif %}

    audit.log_event("CONTRACT_GATE_PASSED", feed_id=FEED_ID)
    return "process_zones"


# ═══════════════════════════════════════════════════════════════════════════════
# FINALIZATION
# ═══════════════════════════════════════════════════════════════════════════════

def finalize_execution(**context) -> Dict[str, Any]:
    """
    Finalize execution: update metadata, send notifications, calculate health score.
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)

    result = ExecutionTracker.finalize(
        feed_id=FEED_ID,
        status="success",
        execution_id=exec_ctx.execution_id,
    )

    audit.log_event(
        "EXECUTION_FINALIZED",
        feed_id=FEED_ID,
        execution_id=exec_ctx.execution_id,
        status="success",
    )

    {% if notification_on_success | default(False) %}
    send_notification(
        feed_id=FEED_ID,
        status="success",
        execution_id=exec_ctx.execution_id,
        recipients={{ notification_emails | default([]) | tojson }},
    )
    {% endif %}

    return result


def handle_failure(**context) -> Dict[str, Any]:
    """
    Handle execution failure: log error, send notification, update status.
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    exception = context.get("exception", "Unknown error")

    result = ExecutionTracker.finalize(
        feed_id=FEED_ID,
        status="failed",
        execution_id=exec_ctx.execution_id,
        error_message=str(exception),
    )

    audit.log_event(
        "EXECUTION_FAILED",
        feed_id=FEED_ID,
        execution_id=exec_ctx.execution_id,
        error=str(exception),
    )

    send_notification(
        feed_id=FEED_ID,
        status="failed",
        execution_id=exec_ctx.execution_id,
        error_message=str(exception),
        recipients={{ notification_emails | default([]) | tojson }},
    )

    return result


# ═══════════════════════════════════════════════════════════════════════════════
# DAG DEFINITION (Thin - Orchestration Only)
# ═══════════════════════════════════════════════════════════════════════════════

with DAG(
    dag_id=DAG_ID,
    default_args=default_args,
    description="{% block dag_description %}{{ dag_id }} - Metadata-Driven Pipeline{% endblock %}",
    schedule=SCHEDULE,
    start_date=datetime(2024, 1, 1),
    catchup={{ catchup | default(False) | tojson }},
    max_active_runs={{ max_active_runs | default(1) }},
    tags=["apex", PATTERN_CODE, DOMAIN, ENVIRONMENT],
) as dag:

    # ─────────────────────────────────────────────────────────────────────────
    # Initialize Execution
    # ─────────────────────────────────────────────────────────────────────────
    init_execution = PythonOperator(
        task_id="init_execution",
        python_callable=ExecutionTracker.initialize,
        op_kwargs={"feed_id": FEED_ID, "metadata_url": config.metadata_db_url},
    )

    # ─────────────────────────────────────────────────────────────────────────
    # Step 1: Validate Metadata Completeness
    # ─────────────────────────────────────────────────────────────────────────
    validate_metadata_task = PythonOperator(
        task_id="validate_metadata",
        python_callable=validate_metadata_completeness,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # Step 3: Build Execution Plan
    # ─────────────────────────────────────────────────────────────────────────
    build_plan_task = PythonOperator(
        task_id="build_execution_plan",
        python_callable=build_execution_plan,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # Source Availability Check (Branch)
    # ─────────────────────────────────────────────────────────────────────────
    check_source_task = BranchPythonOperator(
        task_id="check_source",
        python_callable=check_source_available,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # Contract Gate (Branch)
    # ─────────────────────────────────────────────────────────────────────────
    contract_gate_task = BranchPythonOperator(
        task_id="contract_gate",
        python_callable=check_contract_gate,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # Skip Tasks (No Data / Contract Failed)
    # ─────────────────────────────────────────────────────────────────────────
    skip_no_data = EmptyOperator(task_id="skip_no_data")
    skip_contract_failed = EmptyOperator(task_id="skip_contract_failed")

    # ─────────────────────────────────────────────────────────────────────────
    # Steps 4-6: Zone Processing (Uniform Pattern)
    # ─────────────────────────────────────────────────────────────────────────
    process_zones_start = EmptyOperator(task_id="process_zones")

    {% for zone in zones | default(['transient', 'raw', 'refined', 'trusted', 'consumption']) %}
    with TaskGroup(group_id="zone_{{ zone }}") as zone_{{ zone }}_group:
        process_{{ zone }} = PythonOperator(
            task_id="process",
            python_callable=process_zone,
            op_kwargs={"zone": "{{ zone }}"},
        )

        {% if zone != 'transient' %}
        validate_{{ zone }} = PythonOperator(
            task_id="validate",
            python_callable=validate_zone,
            op_kwargs={"zone": "{{ zone }}"},
        )
        process_{{ zone }} >> validate_{{ zone }}
        {% endif %}

    {% endfor %}

    # ─────────────────────────────────────────────────────────────────────────
    # Finalization
    # ─────────────────────────────────────────────────────────────────────────
    finalize_task = PythonOperator(
        task_id="finalize_execution",
        python_callable=finalize_execution,
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    failure_handler = PythonOperator(
        task_id="handle_failure",
        python_callable=handle_failure,
        trigger_rule=TriggerRule.ONE_FAILED,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # Task Dependencies
    # ─────────────────────────────────────────────────────────────────────────

    # Initialization → Validation → Plan Building
    init_execution >> validate_metadata_task >> build_plan_task >> check_source_task

    # Source check branches
    check_source_task >> [contract_gate_task, skip_no_data]

    # Contract gate branches
    contract_gate_task >> [process_zones_start, skip_contract_failed]

    # Zone processing chain (sequential by default)
    {% set zone_list = zones | default(['transient', 'raw', 'refined', 'trusted', 'consumption']) %}
    process_zones_start >> zone_{{ zone_list[0] }}_group

    {% for i in range(1, zone_list | length) %}
    zone_{{ zone_list[i-1] }}_group >> zone_{{ zone_list[i] }}_group
    {% endfor %}

    # Last zone → Finalization
    zone_{{ zone_list[-1] }}_group >> finalize_task

    # Failure handling
    [skip_no_data, skip_contract_failed] >> failure_handler


