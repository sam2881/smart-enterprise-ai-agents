def generate_execution_plan(**context) -> Dict[str, Any]:
    """
    CONTROL PLANE: Generate ResolvedExecutionPlan (immutable)

    This is the ONLY place decisions happen:
    - Which transformations to apply
    - Which validations to run
    - Retry strategies
    - Schema evolution choices

    Spark jobs receive this plan and execute deterministically.
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    audit.log_event(
        "PLAN_GENERATION_STARTED",
        feed_group_id=FEED_GROUP_ID,
        feed_id=FEED_ID,
        execution_id=exec_ctx.execution_id,
    )

    # Load metadata from PostgreSQL (numeric ID lookup)
    feed_config = metadata.get_feed_config(FEED_ID)
    contract_metadata = metadata.get_contract_metadata(feed_config.contract_id)
    schema_metadata = metadata.get_schema(feed_config.schema_id)

    feed_input = INPUTPARAM[FEED_GROUP_ID]["feeds"][FEED_ID]

    # Generate execution plan (immutable JSON)
    execution_plan = {
        "plan_id": exec_ctx.execution_id,
        "feed_group_id": FEED_GROUP_ID,
        "feed_id": FEED_ID,
        "batch_id": exec_ctx.batch_id,
        "dag_run_id": context["run_id"],
        "pattern_code": PATTERN_CODE,

        # Source configuration
        "source": {
            "source_type": feed_input["source_type"],
            "bucket": INPUTPARAM[FEED_GROUP_ID]["common_config"]["source_bucket"],
            "prefix": INPUTPARAM[FEED_GROUP_ID]["common_config"]["source_prefix"],
            "file_pattern": feed_input["file_pattern"],
            "format": feed_input["file_format"],
            "delimiter": feed_input.get("delimiter", ","),
            "header": feed_input.get("header", True),
            "encoding": feed_input.get("encoding", "UTF-8"),
        },

        # Schema (versioned snapshot from metadata)
        "schema": schema_metadata,

        # Data Vault configuration (if applicable)
        {% if data_vault_type %}
        "data_vault_type": "{{ data_vault_type }}",
        {% endif %}

        # Zone configurations (5-zone architecture)
        "zones": feed_input["zones"],

        # Great Expectations configuration
        "ge_config": {
            "suite_name": feed_input.get("ge_suite_name"),
            "quality_threshold": feed_input.get("quality_threshold", 0.95),
            "expectations_by_zone": {
                "raw": contract_metadata.get("raw_expectations", []),
                "silver": contract_metadata.get("silver_expectations", []),
                "gold": contract_metadata.get("gold_expectations", []),
            },
        },

        # Transformations (ordered list - deterministic execution)
        "transformations": contract_metadata.get("transformations", []),

        # Execution context
        "metadata_db_url": config.metadata_db_url,
        "execution_id": exec_ctx.execution_id,
        "schema_evolution_mode": "{{ schema_evolution_mode | default('strict') }}",

        # Archive configuration
        "archive_config": {
            "enabled": {{ archive_enabled | default(True) | tojson }},
            "bucket": INPUTPARAM[FEED_GROUP_ID]["common_config"]["archive_bucket"],
            "retention_days": {{ archive_retention_days | default(90) }},
        },
    }

    # Persist execution plan for audit and data plane access
    metadata.save_execution_plan(exec_ctx.execution_id, execution_plan)

    audit.log_event(
        "PLAN_GENERATION_COMPLETED",
        feed_id=FEED_ID,
        execution_id=exec_ctx.execution_id,
    )

    return execution_plan


def check_source_files(**context) -> str:
    """
    Check if source files are available for processing.
    Returns branch task ID.
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)

    source_config = INPUTPARAM[FEED_GROUP_ID]["common_config"]
    feed_config = INPUTPARAM[FEED_GROUP_ID]["feeds"][FEED_ID]

    source_files = list_source_files(
        bucket=source_config["source_bucket"],
        prefix=source_config["source_prefix"],
        pattern=feed_config["file_pattern"],
    )

    if not source_files:
        audit.log_event(
            "NO_SOURCE_FILES",
            feed_id=FEED_ID,
            bucket=source_config["source_bucket"],
            prefix=source_config["source_prefix"],
            severity="WARNING",
        )
        return "skip_no_files"

    audit.log_event(
        "SOURCE_FILES_FOUND",
        feed_id=FEED_ID,
        file_count=len(source_files),
    )

    return "check_contract_gate"


def check_contract_gate(**context) -> str:
    """
    CONTRACT GATE: Validate producer contract BEFORE ingestion.

    Fail Fast Policy (default):
    - Schema drift detected → FAIL immediately (no data lands in wrong shape)
    - Missing required columns → FAIL
    - Type changes detected → FAIL
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    ti = context["ti"]
    execution_plan = ti.xcom_pull(task_ids="generate_execution_plan")

    audit.log_event(
        "CONTRACT_CHECK_STARTED",
        feed_id=FEED_ID,
        execution_id=exec_ctx.execution_id,
    )

    # Validate contract
    result = contract_gate.validate_contract(
        feed_id=FEED_ID,
        execution_plan=execution_plan,
        policy="{{ contract_policy | default('FAIL_FAST') }}",
    )

    if not result.is_valid:
        audit.log_event(
            "CONTRACT_CHECK_FAILED",
            feed_id=FEED_ID,
            execution_id=exec_ctx.execution_id,
            violations=result.violations,
        )

        policy = "{{ contract_policy | default('FAIL_FAST') }}"
        if policy == "FAIL_FAST":
            raise ValueError(f"Contract validation failed: {result.violations}")
        elif policy == "WARN":
            return "process_with_warning"
        else:
            return "skip_contract_failed"

    audit.log_event("CONTRACT_CHECK_PASSED", feed_id=FEED_ID)
    return "source_to_transient"


def run_ge_validation(zone: str, **context) -> Dict[str, Any]:
    """
    Run Great Expectations validation for a specific zone.
    """
    ti = context["ti"]
    execution_plan = ti.xcom_pull(task_ids="generate_execution_plan")

    ge_config = execution_plan.get("ge_config", {})
    suite_name = f"{ge_config.get('suite_name')}_{zone}"
    expectations = ge_config.get("expectations_by_zone", {}).get(zone, [])

    if not expectations:
        audit.log_event(
            "GE_VALIDATION_SKIPPED",
            feed_id=FEED_ID,
            zone=zone,
            reason="No expectations defined",
        )
        return {"status": "skipped", "reason": "No expectations defined"}

    # Run Great Expectations
    result = run_great_expectations(
        feed_id=FEED_ID,
        zone=zone,
        suite_name=suite_name,
        expectations=expectations,
        metadata_client=metadata,
    )

    # Check threshold
    quality_threshold = ge_config.get("quality_threshold", 0.95)
    success_rate = result.get("success_rate", 0)

    if success_rate < quality_threshold:
        audit.log_event(
            "GE_VALIDATION_FAILED",
            feed_id=FEED_ID,
            zone=zone,
            success_rate=success_rate,
            threshold=quality_threshold,
        )
        raise ValueError(
            f"GE validation failed in {zone}: {success_rate:.2%} < {quality_threshold:.2%}"
        )

    audit.log_event(
        "GE_VALIDATION_PASSED",
        feed_id=FEED_ID,
        zone=zone,
        success_rate=success_rate,
    )

    return result


def calculate_health_score(**context) -> Dict[str, Any]:
    """
    HEALTH SCORE: Calculate pipeline health as first-class entity.

    health_score = quality(40%) + freshness(30%) + stability(20%) + cost(10%)
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    ti = context["ti"]

    # Gather metrics from this execution
    metrics = ti.xcom_pull(task_ids="collect_metrics") or {}

    health_score = health_calculator.calculate(
        feed_id=FEED_ID,
        execution_id=exec_ctx.execution_id,
        metrics=metrics,
        weights={
            "quality": 0.4,
            "freshness": 0.3,
            "stability": 0.2,
            "cost_efficiency": 0.1,
        },
    )

    # Persist health score
    metadata.save_health_score(FEED_ID, exec_ctx.execution_id, health_score)

    # Promotion gate check (QA → PROD eligibility)
    if ENVIRONMENT == "qa" and health_score.overall_score >= 0.95:
        audit.log_event(
            "PROMOTION_ELIGIBLE",
            feed_id=FEED_ID,
            score=health_score.overall_score,
        )

    # Low health warning
    if health_score.overall_score < 0.7:
        audit.log_event(
            "LOW_HEALTH_SCORE",
            feed_id=FEED_ID,
            score=health_score.overall_score,
            severity="WARNING",
        )

    return health_score.to_dict()


def archive_source_files(**context) -> None:
    """
    Archive processed source files to archive bucket.
    """
    ti = context["ti"]
    execution_plan = ti.xcom_pull(task_ids="generate_execution_plan")

    archive_config = execution_plan.get("archive_config", {})
    if not archive_config.get("enabled", True):
        return

    from dag_utilities.sources.file_source import archive_files

    archive_files(
        source_bucket=execution_plan["source"]["bucket"],
        source_prefix=execution_plan["source"]["prefix"],
        archive_bucket=archive_config["bucket"],
        batch_id=execution_plan["batch_id"],
    )

    audit.log_event(
        "FILES_ARCHIVED",
        feed_id=FEED_ID,
        batch_id=execution_plan["batch_id"],
    )


# ═══════════════════════════════════════════════════════════════════════════════
# DATA PLANE: Spark Job Configurations (Deterministic Execution)
# ═══════════════════════════════════════════════════════════════════════════════

SPARK_JOB_CONFIG = {
    "project_id": config.gcp_project,
    "region": config.dataproc_region,
    "cluster_name": f"apex-{DOMAIN}-{ENVIRONMENT}",
}


def get_zone_spark_job(zone: str) -> dict:
    """Generate Spark job config for zone transformation."""
    return {
        "reference": {"project_id": SPARK_JOB_CONFIG["project_id"]},
        "placement": {"cluster_name": SPARK_JOB_CONFIG["cluster_name"]},
        "pyspark_job": {
            "main_python_file_uri": f"gs://{config.spark_jobs_bucket}/apex/jobs/p01_{zone}_transform.py",
            "args": [
                "--feed-id", str(FEED_ID),
                "--zone", zone,
                "--metadata-db-url", config.metadata_db_url,
            ],
            "properties": {
                "spark.executor.memory": INPUTPARAM[FEED_GROUP_ID]["common_config"]["spark_executor_memory"],
                "spark.executor.cores": str(INPUTPARAM[FEED_GROUP_ID]["common_config"]["spark_executor_cores"]),
                "spark.dynamicAllocation.enabled": "true",
                "spark.sql.adaptive.enabled": "true",
            },
        },
    }


# ═══════════════════════════════════════════════════════════════════════════════
# DAG DEFINITION
# ═══════════════════════════════════════════════════════════════════════════════

with DAG(
    dag_id=DAG_ID,
    default_args=default_args,
    description=f"P01 File Medallion Pipeline: {DOMAIN}.{{ feed_name }}",
    schedule_interval=SCHEDULE,
    start_date=datetime({{ start_year | default(2024) }}, 1, 1),
    catchup={{ catchup | default(False) }},
    max_active_runs={{ max_active_runs | default(1) }},
    tags=["apex", "p01", "file", "medallion", DOMAIN, ENVIRONMENT],
    doc_md=__doc__,
) as dag:

    # ─────────────────────────────────────────────────────────────────────────
    # START: Control Plane - Generate Execution Plan
    # ─────────────────────────────────────────────────────────────────────────

    start = EmptyOperator(task_id="start")

    generate_plan = PythonOperator(
        task_id="generate_execution_plan",
        python_callable=generate_execution_plan,
        provide_context=True,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # SOURCE FILE CHECK
    # ─────────────────────────────────────────────────────────────────────────

    source_check = BranchPythonOperator(
        task_id="check_source_files",
        python_callable=check_source_files,
        provide_context=True,
    )

    skip_no_files = EmptyOperator(task_id="skip_no_files")

    # ─────────────────────────────────────────────────────────────────────────
    # CONTRACT GATE: Validate Before Ingestion
    # ─────────────────────────────────────────────────────────────────────────

    contract_check = BranchPythonOperator(
        task_id="check_contract_gate",
        python_callable=check_contract_gate,
        provide_context=True,
    )

    skip_contract_failed = EmptyOperator(task_id="skip_contract_failed")
    process_with_warning = EmptyOperator(task_id="process_with_warning")

    # ─────────────────────────────────────────────────────────────────────────
    # SOURCE → TRANSIENT (Raw landing)
    # ─────────────────────────────────────────────────────────────────────────

    with TaskGroup(group_id="source_to_transient") as transient_group:

        ingest_to_transient = DataprocSubmitJobOperator(
            task_id="ingest_files",
            job=get_zone_spark_job("transient"),
            region=SPARK_JOB_CONFIG["region"],
            project_id=SPARK_JOB_CONFIG["project_id"],
        )

    # ─────────────────────────────────────────────────────────────────────────
    # TRANSIENT → RAW (Schema enforcement)
    # ─────────────────────────────────────────────────────────────────────────

    with TaskGroup(group_id="transient_to_raw") as raw_group:

        raw_transform = DataprocSubmitJobOperator(
            task_id="transform_to_raw",
            job=get_zone_spark_job("raw"),
            region=SPARK_JOB_CONFIG["region"],
            project_id=SPARK_JOB_CONFIG["project_id"],
        )

        raw_ge_validation = PythonOperator(
            task_id="raw_ge_validation",
            python_callable=run_ge_validation,
            op_kwargs={"zone": "raw"},
            provide_context=True,
        )

        raw_transform >> raw_ge_validation

    # ─────────────────────────────────────────────────────────────────────────
    # RAW → SILVER (Cleaning, deduplication)
    # ─────────────────────────────────────────────────────────────────────────

    with TaskGroup(group_id="raw_to_silver") as silver_group:

        silver_transform = DataprocSubmitJobOperator(
            task_id="transform_to_silver",
            job=get_zone_spark_job("silver"),
            region=SPARK_JOB_CONFIG["region"],
            project_id=SPARK_JOB_CONFIG["project_id"],
        )

        silver_ge_validation = PythonOperator(
            task_id="silver_ge_validation",
            python_callable=run_ge_validation,
            op_kwargs={"zone": "silver"},
            provide_context=True,
        )

        silver_transform >> silver_ge_validation

    # ─────────────────────────────────────────────────────────────────────────
    # SILVER → GOLD (Business rules, joins)
    # ─────────────────────────────────────────────────────────────────────────

    with TaskGroup(group_id="silver_to_gold") as gold_group:

        gold_transform = DataprocSubmitJobOperator(
            task_id="transform_to_gold",
            job=get_zone_spark_job("gold"),
            region=SPARK_JOB_CONFIG["region"],
            project_id=SPARK_JOB_CONFIG["project_id"],
        )

        gold_ge_validation = PythonOperator(
            task_id="gold_ge_validation",
            python_callable=run_ge_validation,
            op_kwargs={"zone": "gold"},
            provide_context=True,
        )

        gold_transform >> gold_ge_validation

    {% if include_consumption %}
    # ─────────────────────────────────────────────────────────────────────────
    # GOLD → CONSUMPTION (Analytics layer - optional)
    # ─────────────────────────────────────────────────────────────────────────

    with TaskGroup(group_id="gold_to_consumption") as consumption_group:

        consumption_transform = DataprocSubmitJobOperator(
            task_id="transform_to_consumption",
            job=get_zone_spark_job("consumption"),
            region=SPARK_JOB_CONFIG["region"],
            project_id=SPARK_JOB_CONFIG["project_id"],
        )
    {% endif %}

    # ─────────────────────────────────────────────────────────────────────────
    # COMPLETION: Metrics, Health Score, Archive
    # ─────────────────────────────────────────────────────────────────────────

    collect_metrics = PythonOperator(
        task_id="collect_metrics",
        python_callable=lambda **ctx: pipeline_tasks.collect_execution_metrics(
            ctx["ti"].xcom_pull(task_ids="generate_execution_plan"),
            metadata_client=metadata,
        ),
        provide_context=True,
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    health_score = PythonOperator(
        task_id="calculate_health_score",
        python_callable=calculate_health_score,
        provide_context=True,
    )

    archive_files = PythonOperator(
        task_id="archive_source_files",
        python_callable=archive_source_files,
        provide_context=True,
    )

    update_metadata = PythonOperator(
        task_id="update_metadata",
        python_callable=lambda **ctx: metadata.update_ingestion_status(
            feed_id=FEED_ID,
            execution_id=ExecutionContext.from_airflow_context(ctx).execution_id,
            status="success",
        ),
        provide_context=True,
    )

    end_success = EmptyOperator(
        task_id="end_success",
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # ERROR HANDLING
    # ─────────────────────────────────────────────────────────────────────────

    end_failure = PythonOperator(
        task_id="end_failure",
        python_callable=lambda **ctx: audit.log_event(
            "PIPELINE_FAILED",
            feed_id=FEED_ID,
            execution_id=ExecutionContext.from_airflow_context(ctx).execution_id,
            error=str(ctx.get("exception", "Unknown error")),
        ),
        provide_context=True,
        trigger_rule=TriggerRule.ONE_FAILED,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # TASK DEPENDENCIES (5-Zone Medallion Flow)
    # ─────────────────────────────────────────────────────────────────────────

    # Control plane flow
    start >> generate_plan >> source_check

    # Source check branching
    source_check >> [contract_check, skip_no_files]

    # Contract gate branching
    contract_check >> [transient_group, skip_contract_failed, process_with_warning]
    process_with_warning >> transient_group

    # 5-Zone medallion flow
    {% if include_consumption %}
    transient_group >> raw_group >> silver_group >> gold_group >> consumption_group
    consumption_group >> collect_metrics
    {% else %}
    transient_group >> raw_group >> silver_group >> gold_group
    gold_group >> collect_metrics
    {% endif %}

    # Completion flow
    collect_metrics >> health_score >> archive_files >> update_metadata >> end_success

    # Skip paths converge
    [skip_no_files, skip_contract_failed] >> end_success

    # Error handling
    [transient_group, raw_group, silver_group, gold_group] >> end_failure


