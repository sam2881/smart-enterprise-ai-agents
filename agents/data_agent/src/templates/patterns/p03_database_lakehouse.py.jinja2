from airflow.operators.empty import EmptyOperator
from airflow.utils.trigger_rule import TriggerRule
from airflow.utils.task_group import TaskGroup
from airflow.providers.google.cloud.operators.dataproc import DataprocSubmitJobOperator
from airflow.providers.google.cloud.sensors.bigquery import BigQueryTableExistenceSensor

from dag_utilities.core import MetadataClient, ExecutionContext, APEXConfig
from dag_utilities.pipeline import pipeline_tasks
from dag_utilities.sources.database_source import get_jdbc_connection, build_extraction_query
from dag_utilities.common.zone_transition import submit_dataproc_job
from dag_utilities.common.sql_executor import run_bq_query
from dag_utilities.validation import SchemaValidator, SemanticValidator
from dag_utilities.notification import EmailNotifier
from dag_utilities.logging import AuditLogger
from dag_utilities.remediation import SelfHealer, RetryHandler
from dag_utilities.governance import ContractGate, HealthScoreCalculator


# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURATION (Control Plane - Metadata-Driven)
# ═══════════════════════════════════════════════════════════════════════════════

DAG_ID = "{{ dag_id }}"
FEED_ID = {{ feed_id }}  # Numeric ID from PostgreSQL
PATTERN_CODE = "P03"
DOMAIN = "{{ domain }}"
ENVIRONMENT = os.getenv("APEX_ENVIRONMENT", "{{ environment | default('dev') }}")

# Group Feed ID for multi-table scenarios (when splitting from one source)
{% if group_feed_id %}
GROUP_FEED_ID = {{ group_feed_id }}
{% endif %}

# Initialize clients
config = APEXConfig.from_environment()
metadata = MetadataClient(config.metadata_db_url)
retry_handler = RetryHandler(max_retries={{ retry_count | default(3) }})
audit = AuditLogger(metadata)
contract_gate = ContractGate(metadata)
health_calculator = HealthScoreCalculator(metadata)

# Schedule configuration (per-environment)
SCHEDULES = {{ schedule | default({'dev': '@daily', 'qa': '@daily', 'prod': '@daily'}) | tojson }}
SCHEDULE = SCHEDULES.get(ENVIRONMENT, "@daily")

# Notification configuration
NOTIFICATIONS = {{ notification_emails | default({'dev': [], 'qa': [], 'prod': []}) | tojson }}
NOTIFY_EMAILS = NOTIFICATIONS.get(ENVIRONMENT, [])

# Extraction mode configuration
EXTRACTION_MODE = "{{ extraction_mode | default('full') }}"  # full, incremental, cdc
WATERMARK_COLUMN = "{{ watermark_column | default('updated_at') }}"
BATCH_SIZE = {{ batch_size | default(100000) }}

default_args = {
    "owner": "{{ owner | default('apex-data-agent') }}",
    "depends_on_past": {{ depends_on_past | default(False) }},
    "email": NOTIFY_EMAILS,
    "email_on_failure": True,
    "email_on_retry": False,
    **retry_handler.get_airflow_retry_args(),
}


# ═══════════════════════════════════════════════════════════════════════════════
# CONTROL PLANE FUNCTIONS (Decision Logic - NOT in Spark Jobs)
# ═══════════════════════════════════════════════════════════════════════════════

def generate_execution_plan(**context):
    """
    CONTROL PLANE: Generate ResolvedExecutionPlan (immutable)
    Spark jobs receive this plan and execute deterministically.
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    audit.log_event("PLAN_GENERATION_STARTED", feed_id=FEED_ID, execution_id=exec_ctx.execution_id)

    # Load metadata from PostgreSQL (numeric ID lookup)
    feed_config = metadata.get_feed_config(FEED_ID)
    contract_metadata = metadata.get_contract_metadata(feed_config.contract_id)
    schema_metadata = metadata.get_schema(feed_config.schema_id)
    source_config = metadata.get_source_config(feed_config.source_id)

    # Get last watermark for incremental loads
    last_watermark = None
    if EXTRACTION_MODE in ("incremental", "cdc"):
        last_watermark = metadata.get_last_watermark(FEED_ID)

    # Build extraction query based on mode
    extraction_query = build_extraction_query(
        source_config=source_config,
        extraction_mode=EXTRACTION_MODE,
        watermark_column=WATERMARK_COLUMN,
        last_watermark=last_watermark,
        batch_size=BATCH_SIZE,
    )

    # Generate execution plan (immutable JSON)
    execution_plan = {
        "plan_id": exec_ctx.execution_id,
        "feed_id": FEED_ID,
        "batch_id": exec_ctx.batch_id,
        "pattern": PATTERN_CODE,
        {% if group_feed_id %}
        "group_feed_id": GROUP_FEED_ID,
        {% endif %}

        # Source configuration (JDBC)
        "source": {
            "source_type": "{{ source_type | default('database_postgres') }}",
            "connection_id": "{{ connection_id }}",
            "source_schema": "{{ source_schema | default('public') }}",
            "source_table": "{{ source_table }}",
            "extraction_query": extraction_query,
            "extraction_mode": EXTRACTION_MODE,
            "watermark_column": WATERMARK_COLUMN,
            "last_watermark": last_watermark,
            "batch_size": BATCH_SIZE,
        },

        # Schema (versioned snapshot)
        "schema": schema_metadata,

        # Transformations (ordered list)
        "transformations": contract_metadata.get("transformations", []),

        # Validations by zone
        "validations": {
            "bronze": [
                {% for rule in bronze_validations | default([]) %}
                {{ rule | tojson }},
                {% endfor %}
            ],
            "silver": [
                {% for rule in silver_validations | default([]) %}
                {{ rule | tojson }},
                {% endfor %}
            ],
            "gold": [
                {% for rule in gold_validations | default([]) %}
                {{ rule | tojson }},
                {% endfor %}
            ],
        },

        # Targets by zone
        "targets": {
            "landing": f"gs://{{ landing_bucket | default('apex-landing') }}/{DOMAIN}/{DAG_ID}/{{{{ exec_ctx.batch_id }}}}",
            "bronze": {
                "dataset": "{{ bronze_dataset | default('bronze') }}",
                "table": "{{ bronze_table | default(dag_id) }}",
                "partition_column": "{{ partition_column | default('ingestion_date') }}",
                "clustering_columns": {{ clustering_columns | default(['updated_at']) | tojson }},
                "write_mode": "{{ bronze_write_mode | default('append') }}",
            },
            "silver": {
                "dataset": "{{ silver_dataset | default('silver') }}",
                "table": "{{ silver_table | default(dag_id) }}",
                "partition_column": "{{ partition_column | default('ingestion_date') }}",
                "write_mode": "{{ silver_write_mode | default('merge') }}",
            },
            "gold": {
                "dataset": "{{ gold_dataset | default('gold') }}",
                "table": "{{ gold_table | default(dag_id) }}",
                "write_mode": "{{ gold_write_mode | default('merge') }}",
            },
        },

        # Execution context
        "metadata_db_url": config.metadata_db_url,
        "execution_id": exec_ctx.execution_id,
        "schema_evolution_mode": "{{ schema_evolution_mode | default('WARN') }}",
    }

    # Persist execution plan for audit and data plane access
    metadata.save_execution_plan(exec_ctx.execution_id, execution_plan)
    audit.log_event("PLAN_GENERATION_COMPLETED", feed_id=FEED_ID, execution_id=exec_ctx.execution_id)

    return execution_plan


def check_producer_contract(**context):
    """
    CONTRACT GATE: Validate producer contract BEFORE extraction.

    Fail Fast Policy (default):
    - Schema drift detected → FAIL immediately (no data lands in wrong shape)
    - Missing required columns → FAIL
    - Type changes detected → FAIL

    Warn Policy:
    - Log warning but continue

    Adapt Policy:
    - Auto-evolve schema (dangerous - use with caution)
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    ti = context["ti"]
    execution_plan = ti.xcom_pull(task_ids="generate_execution_plan")

    audit.log_event("CONTRACT_CHECK_STARTED", feed_id=FEED_ID, execution_id=exec_ctx.execution_id)

    # Validate contract
    contract_result = contract_gate.validate_contract(
        feed_id=FEED_ID,
        execution_plan=execution_plan,
        policy="{{ contract_policy | default('FAIL_FAST') }}",
    )

    if not contract_result.is_valid:
        audit.log_event(
            "CONTRACT_CHECK_FAILED",
            feed_id=FEED_ID,
            execution_id=exec_ctx.execution_id,
            violations=contract_result.violations,
        )

        # Branch based on policy
        if "{{ contract_policy | default('FAIL_FAST') }}" == "FAIL_FAST":
            raise ValueError(f"Contract validation failed: {contract_result.violations}")
        elif "{{ contract_policy | default('FAIL_FAST') }}" == "WARN":
            return "continue_with_warning"
        else:
            return "skip_pipeline"

    audit.log_event("CONTRACT_CHECK_PASSED", feed_id=FEED_ID, execution_id=exec_ctx.execution_id)
    return "extract_from_database"


def calculate_health_score(**context):
    """
    HEALTH SCORE: Calculate pipeline health as first-class entity.

    health_score = quality(40%) + freshness(30%) + stability(20%) + cost(10%)
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    ti = context["ti"]

    # Gather metrics from this execution
    metrics = ti.xcom_pull(task_ids="collect_metrics")

    health_score = health_calculator.calculate(
        feed_id=FEED_ID,
        execution_id=exec_ctx.execution_id,
        metrics=metrics,
        weights={
            "quality": 0.4,
            "freshness": 0.3,
            "stability": 0.2,
            "cost_efficiency": 0.1,
        }
    )

    # Persist health score
    metadata.save_health_score(FEED_ID, exec_ctx.execution_id, health_score)

    # Promotion gate check
    if ENVIRONMENT == "qa" and health_score.overall_score >= 0.95:
        audit.log_event("PROMOTION_ELIGIBLE", feed_id=FEED_ID, score=health_score.overall_score)

    return health_score.to_dict()


def update_watermark(**context):
    """
    Update watermark for incremental loads.
    Only called on successful completion.
    """
    ti = context["ti"]
    exec_ctx = ExecutionContext.from_airflow_context(context)

    if EXTRACTION_MODE in ("incremental", "cdc"):
        metrics = ti.xcom_pull(task_ids="collect_metrics") or {}
        new_watermark = metrics.get("max_watermark")

        if new_watermark:
            metadata.update_watermark(FEED_ID, new_watermark)
            audit.log_event(
                "WATERMARK_UPDATED",
                feed_id=FEED_ID,
                old_watermark=metadata.get_last_watermark(FEED_ID),
                new_watermark=new_watermark,
            )


# ═══════════════════════════════════════════════════════════════════════════════
# DATA PLANE: Spark Job Configurations (Deterministic Execution)
# ═══════════════════════════════════════════════════════════════════════════════

# Spark job definitions - receive execution_plan as JSON, execute deterministically
SPARK_JOB_CONFIG = {
    "project_id": config.gcp_project,
    "region": config.dataproc_region,
    "cluster_name": f"apex-{DOMAIN}-{ENVIRONMENT}",
}

def get_extract_job_config(execution_plan: dict) -> dict:
    """Generate Spark job config for database extraction."""
    return {
        "reference": {"project_id": SPARK_JOB_CONFIG["project_id"]},
        "placement": {"cluster_name": SPARK_JOB_CONFIG["cluster_name"]},
        "pyspark_job": {
            "main_python_file_uri": f"gs://{config.spark_jobs_bucket}/apex/jobs/p03_database_extract.py",
            "args": [
                "--execution-plan-id", execution_plan["plan_id"],
                "--metadata-db-url", config.metadata_db_url,
            ],
            "properties": {
                "spark.executor.memory": "{{ spark_executor_memory | default('8g') }}",
                "spark.executor.cores": "{{ spark_executor_cores | default('4') }}",
                "spark.dynamicAllocation.enabled": "true",
                "spark.sql.adaptive.enabled": "true",
            },
        },
    }


def get_transform_job_config(execution_plan: dict, zone: str) -> dict:
    """Generate Spark job config for zone transformation."""
    return {
        "reference": {"project_id": SPARK_JOB_CONFIG["project_id"]},
        "placement": {"cluster_name": SPARK_JOB_CONFIG["cluster_name"]},
        "pyspark_job": {
            "main_python_file_uri": f"gs://{config.spark_jobs_bucket}/apex/jobs/p03_{zone}_transform.py",
            "args": [
                "--execution-plan-id", execution_plan["plan_id"],
                "--zone", zone,
                "--metadata-db-url", config.metadata_db_url,
            ],
            "properties": {
                "spark.executor.memory": "{{ spark_executor_memory | default('8g') }}",
                "spark.executor.cores": "{{ spark_executor_cores | default('4') }}",
                "spark.sql.adaptive.enabled": "true",
            },
        },
    }


# ═══════════════════════════════════════════════════════════════════════════════
# DAG DEFINITION
# ═══════════════════════════════════════════════════════════════════════════════

with DAG(
    dag_id=DAG_ID,
    default_args=default_args,
    description=f"P03 Database Lakehouse Pipeline: {DOMAIN}.{DAG_ID}",
    schedule_interval=SCHEDULE,
    start_date=datetime({{ start_year | default(2024) }}, 1, 1),
    catchup={{ catchup | default(False) }},
    max_active_runs={{ max_active_runs | default(1) }},
    tags=["apex", "p03", "database", DOMAIN, ENVIRONMENT],
    doc_md=__doc__,
) as dag:

    # ─────────────────────────────────────────────────────────────────────────
    # START: Control Plane - Generate Execution Plan
    # ─────────────────────────────────────────────────────────────────────────

    start = EmptyOperator(task_id="start")

    generate_plan = PythonOperator(
        task_id="generate_execution_plan",
        python_callable=generate_execution_plan,
        provide_context=True,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # CONTRACT GATE: Validate Before Extraction
    # ─────────────────────────────────────────────────────────────────────────

    contract_check = BranchPythonOperator(
        task_id="check_producer_contract",
        python_callable=check_producer_contract,
        provide_context=True,
    )

    skip_pipeline = EmptyOperator(task_id="skip_pipeline")
    continue_with_warning = EmptyOperator(task_id="continue_with_warning")

    # ─────────────────────────────────────────────────────────────────────────
    # DATA PLANE: Database Extraction → Landing
    # ─────────────────────────────────────────────────────────────────────────

    with TaskGroup(group_id="extraction") as extraction_group:

        extract_from_db = DataprocSubmitJobOperator(
            task_id="extract_from_database",
            job=get_extract_job_config("{{ '{{' }} ti.xcom_pull(task_ids='generate_execution_plan') {{ '}}' }}"),
            region=SPARK_JOB_CONFIG["region"],
            project_id=SPARK_JOB_CONFIG["project_id"],
        )

    # ─────────────────────────────────────────────────────────────────────────
    # LANDING → BRONZE: Schema Enforcement
    # ─────────────────────────────────────────────────────────────────────────

    with TaskGroup(group_id="landing_to_bronze") as bronze_group:

        bronze_transform = DataprocSubmitJobOperator(
            task_id="landing_to_bronze_transform",
            job=get_transform_job_config("{{ '{{' }} ti.xcom_pull(task_ids='generate_execution_plan') {{ '}}' }}", "bronze"),
            region=SPARK_JOB_CONFIG["region"],
            project_id=SPARK_JOB_CONFIG["project_id"],
        )

        bronze_validate = PythonOperator(
            task_id="bronze_validation",
            python_callable=lambda **ctx: pipeline_tasks.run_zone_validation(
                ctx["ti"].xcom_pull(task_ids="generate_execution_plan"),
                zone="bronze",
                metadata_client=metadata,
            ),
            provide_context=True,
        )

        bronze_transform >> bronze_validate

    # ─────────────────────────────────────────────────────────────────────────
    # BRONZE → SILVER: Data Quality & Deduplication
    # ─────────────────────────────────────────────────────────────────────────

    with TaskGroup(group_id="bronze_to_silver") as silver_group:

        silver_transform = DataprocSubmitJobOperator(
            task_id="bronze_to_silver_transform",
            job=get_transform_job_config("{{ '{{' }} ti.xcom_pull(task_ids='generate_execution_plan') {{ '}}' }}", "silver"),
            region=SPARK_JOB_CONFIG["region"],
            project_id=SPARK_JOB_CONFIG["project_id"],
        )

        silver_validate = PythonOperator(
            task_id="silver_validation",
            python_callable=lambda **ctx: pipeline_tasks.run_zone_validation(
                ctx["ti"].xcom_pull(task_ids="generate_execution_plan"),
                zone="silver",
                metadata_client=metadata,
            ),
            provide_context=True,
        )

        silver_transform >> silver_validate

    # ─────────────────────────────────────────────────────────────────────────
    # SILVER → GOLD: Business Logic & Aggregations
    # ─────────────────────────────────────────────────────────────────────────

    with TaskGroup(group_id="silver_to_gold") as gold_group:

        gold_transform = DataprocSubmitJobOperator(
            task_id="silver_to_gold_transform",
            job=get_transform_job_config("{{ '{{' }} ti.xcom_pull(task_ids='generate_execution_plan') {{ '}}' }}", "gold"),
            region=SPARK_JOB_CONFIG["region"],
            project_id=SPARK_JOB_CONFIG["project_id"],
        )

        gold_validate = PythonOperator(
            task_id="gold_validation",
            python_callable=lambda **ctx: pipeline_tasks.run_zone_validation(
                ctx["ti"].xcom_pull(task_ids="generate_execution_plan"),
                zone="gold",
                metadata_client=metadata,
            ),
            provide_context=True,
        )

        gold_transform >> gold_validate

    # ─────────────────────────────────────────────────────────────────────────
    # COMPLETION: Metrics, Health Score, Watermark Update
    # ─────────────────────────────────────────────────────────────────────────

    collect_metrics = PythonOperator(
        task_id="collect_metrics",
        python_callable=lambda **ctx: pipeline_tasks.collect_execution_metrics(
            ctx["ti"].xcom_pull(task_ids="generate_execution_plan"),
            metadata_client=metadata,
        ),
        provide_context=True,
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    health_score = PythonOperator(
        task_id="calculate_health_score",
        python_callable=calculate_health_score,
        provide_context=True,
    )

    watermark_update = PythonOperator(
        task_id="update_watermark",
        python_callable=update_watermark,
        provide_context=True,
    )

    end_success = EmptyOperator(
        task_id="end_success",
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # ERROR HANDLING
    # ─────────────────────────────────────────────────────────────────────────

    end_failure = PythonOperator(
        task_id="end_failure",
        python_callable=lambda **ctx: audit.log_event(
            "PIPELINE_FAILED",
            feed_id=FEED_ID,
            execution_id=ExecutionContext.from_airflow_context(ctx).execution_id,
            error=str(ctx.get("exception", "Unknown error")),
        ),
        provide_context=True,
        trigger_rule=TriggerRule.ONE_FAILED,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # TASK DEPENDENCIES
    # ─────────────────────────────────────────────────────────────────────────

    # Control plane flow
    start >> generate_plan >> contract_check

    # Contract gate branching
    contract_check >> [extract_from_db, skip_pipeline, continue_with_warning]
    continue_with_warning >> extract_from_db

    # Data plane flow (medallion)
    extraction_group >> bronze_group >> silver_group >> gold_group

    # Completion flow
    gold_group >> collect_metrics >> health_score >> watermark_update >> end_success

    # Error handling
    [bronze_group, silver_group, gold_group] >> end_failure
