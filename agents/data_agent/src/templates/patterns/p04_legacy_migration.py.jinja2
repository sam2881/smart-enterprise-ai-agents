# DATA PLANE: Spark Job Configurations (Deterministic Execution)
# ═══════════════════════════════════════════════════════════════════════════════

SPARK_JOB_CONFIG = {
    "project_id": config.gcp_project,
    "region": config.dataproc_region,
    "cluster_name": f"apex-{DOMAIN}-{ENVIRONMENT}",
}


def get_legacy_parse_job(execution_plans: Dict[int, Dict]) -> dict:
    """Spark job config for parsing legacy source."""
    return {
        "reference": {"project_id": SPARK_JOB_CONFIG["project_id"]},
        "placement": {"cluster_name": SPARK_JOB_CONFIG["cluster_name"]},
        "pyspark_job": {
            "main_python_file_uri": f"gs://{config.spark_jobs_bucket}/apex/jobs/p04_legacy_parse.py",
            "args": [
                "--feed-group-id", str(FEED_GROUP_ID),
                "--execution-plans", "{{ '{{' }} ti.xcom_pull(task_ids='generate_execution_plan') | tojson {{ '}}' }}",
                "--metadata-db-url", config.metadata_db_url,
                "--source-type", LEGACY_SOURCE_TYPE,
            ],
            "properties": {
                "spark.executor.memory": INPUTPARAM[FEED_GROUP_ID]["common_config"]["spark_executor_memory"],
                "spark.executor.cores": str(INPUTPARAM[FEED_GROUP_ID]["common_config"]["spark_executor_cores"]),
                "spark.dynamicAllocation.enabled": "true",
            },
        },
    }


def get_zone_transform_job(zone: str, feed_id: int) -> dict:
    """Spark job config for zone transformation."""
    return {
        "reference": {"project_id": SPARK_JOB_CONFIG["project_id"]},
        "placement": {"cluster_name": SPARK_JOB_CONFIG["cluster_name"]},
        "pyspark_job": {
            "main_python_file_uri": f"gs://{config.spark_jobs_bucket}/apex/jobs/p04_{zone}_transform.py",
            "args": [
                "--feed-id", str(feed_id),
                "--zone", zone,
                "--metadata-db-url", config.metadata_db_url,
            ],
            "properties": {
                "spark.executor.memory": INPUTPARAM[FEED_GROUP_ID]["common_config"]["spark_executor_memory"],
                "spark.executor.cores": str(INPUTPARAM[FEED_GROUP_ID]["common_config"]["spark_executor_cores"]),
                "spark.sql.adaptive.enabled": "true",
            },
        },
    }


# ═══════════════════════════════════════════════════════════════════════════════
# DAG DEFINITION
# ═══════════════════════════════════════════════════════════════════════════════

with DAG(
    dag_id=DAG_ID,
    default_args=default_args,
    description=f"P04 Legacy Migration Pipeline: {DOMAIN}.{DAG_ID}",
    schedule_interval=SCHEDULE,
    start_date=datetime({{ start_year | default(2024) }}, 1, 1),
    catchup={{ catchup | default(False) }},
    max_active_runs={{ max_active_runs | default(1) }},
    tags=["apex", "p04", "legacy", LEGACY_SOURCE_TYPE, DOMAIN, ENVIRONMENT],
    doc_md=__doc__,
) as dag:

    # ─────────────────────────────────────────────────────────────────────────
    # START: Control Plane
    # ─────────────────────────────────────────────────────────────────────────

    start = EmptyOperator(task_id="start")

    generate_plan = PythonOperator(
        task_id="generate_execution_plan",
        python_callable=generate_execution_plan,
        provide_context=True,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # SOURCE AVAILABILITY CHECK
    # ─────────────────────────────────────────────────────────────────────────

    source_check = BranchPythonOperator(
        task_id="check_source_availability",
        python_callable=check_source_availability,
        provide_context=True,
    )

    skip_pipeline = EmptyOperator(task_id="skip_pipeline")

    # ─────────────────────────────────────────────────────────────────────────
    # CONTRACT GATE
    # ─────────────────────────────────────────────────────────────────────────

    contract_check = BranchPythonOperator(
        task_id="check_contract_gate",
        python_callable=check_contract_gate,
        provide_context=True,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # LEGACY SOURCE PARSING → TRANSIENT
    # ─────────────────────────────────────────────────────────────────────────

    with TaskGroup(group_id="parse_legacy_source") as parse_group:

        parse_legacy = DataprocSubmitJobOperator(
            task_id="parse_to_transient",
            job=get_legacy_parse_job({}),  # Plans fetched via XCom in Spark
            region=SPARK_JOB_CONFIG["region"],
            project_id=SPARK_JOB_CONFIG["project_id"],
        )

    # ─────────────────────────────────────────────────────────────────────────
    # PROCESS EACH FEED: TRANSIENT → RAW → SILVER → GOLD
    # ─────────────────────────────────────────────────────────────────────────

    with TaskGroup(group_id="process_feeds") as feeds_group:

        {% for feed in feeds %}
        # ═══════════════════════════════════════════════════════════════════
        # FEED {{ feed.feed_id }}: {{ feed.feed_name }}
        # ═══════════════════════════════════════════════════════════════════

        with TaskGroup(group_id="feed_{{ feed.feed_id }}") as feed_{{ feed.feed_id }}_group:

            # ───────────────────────────────────────────────────────────────
            # TRANSIENT → RAW
            # ───────────────────────────────────────────────────────────────

            transient_to_raw_{{ feed.feed_id }} = DataprocSubmitJobOperator(
                task_id="transient_to_raw",
                job=get_zone_transform_job("raw", {{ feed.feed_id }}),
                region=SPARK_JOB_CONFIG["region"],
                project_id=SPARK_JOB_CONFIG["project_id"],
            )

            raw_ge_validation_{{ feed.feed_id }} = PythonOperator(
                task_id="raw_ge_validation",
                python_callable=run_ge_validation,
                op_kwargs={"zone": "raw", "feed_id": {{ feed.feed_id }}},
                provide_context=True,
            )

            # ───────────────────────────────────────────────────────────────
            # RAW → SILVER
            # ───────────────────────────────────────────────────────────────

            raw_to_silver_{{ feed.feed_id }} = DataprocSubmitJobOperator(
                task_id="raw_to_silver",
                job=get_zone_transform_job("silver", {{ feed.feed_id }}),
                region=SPARK_JOB_CONFIG["region"],
                project_id=SPARK_JOB_CONFIG["project_id"],
            )

            silver_ge_validation_{{ feed.feed_id }} = PythonOperator(
                task_id="silver_ge_validation",
                python_callable=run_ge_validation,
                op_kwargs={"zone": "silver", "feed_id": {{ feed.feed_id }}},
                provide_context=True,
            )

            # ───────────────────────────────────────────────────────────────
            # SILVER → GOLD
            # ───────────────────────────────────────────────────────────────

            silver_to_gold_{{ feed.feed_id }} = DataprocSubmitJobOperator(
                task_id="silver_to_gold",
                job=get_zone_transform_job("gold", {{ feed.feed_id }}),
                region=SPARK_JOB_CONFIG["region"],
                project_id=SPARK_JOB_CONFIG["project_id"],
            )

            gold_ge_validation_{{ feed.feed_id }} = PythonOperator(
                task_id="gold_ge_validation",
                python_callable=run_ge_validation,
                op_kwargs={"zone": "gold", "feed_id": {{ feed.feed_id }}},
                provide_context=True,
            )

            # ───────────────────────────────────────────────────────────────
            # COLLECT METRICS
            # ───────────────────────────────────────────────────────────────

            collect_metrics_{{ feed.feed_id }} = PythonOperator(
                task_id="collect_metrics_{{ feed.feed_id }}",
                python_callable=lambda **ctx: pipeline_tasks.collect_execution_metrics(
                    ctx["ti"].xcom_pull(task_ids="generate_execution_plan")[{{ feed.feed_id }}],
                    metadata_client=metadata,
                ),
                provide_context=True,
            )

            # Task dependencies within feed
            (
                transient_to_raw_{{ feed.feed_id }}
                >> raw_ge_validation_{{ feed.feed_id }}
                >> raw_to_silver_{{ feed.feed_id }}
                >> silver_ge_validation_{{ feed.feed_id }}
                >> silver_to_gold_{{ feed.feed_id }}
                >> gold_ge_validation_{{ feed.feed_id }}
                >> collect_metrics_{{ feed.feed_id }}
            )

        {% endfor %}

    # ─────────────────────────────────────────────────────────────────────────
    # COMPLETION: Health Score Calculation
    # ─────────────────────────────────────────────────────────────────────────

    health_scores = PythonOperator(
        task_id="calculate_health_scores",
        python_callable=calculate_health_score,
        provide_context=True,
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    update_metadata = PythonOperator(
        task_id="update_metadata",
        python_callable=lambda **ctx: metadata.update_ingestion_status(
            feed_group_id=FEED_GROUP_ID,
            execution_id=ExecutionContext.from_airflow_context(ctx).execution_id,
            status="success",
        ),
        provide_context=True,
    )

    end_success = EmptyOperator(
        task_id="end_success",
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # ERROR HANDLING
    # ─────────────────────────────────────────────────────────────────────────

    end_failure = PythonOperator(
        task_id="end_failure",
        python_callable=lambda **ctx: audit.log_event(
            "PIPELINE_FAILED",
            feed_group_id=FEED_GROUP_ID,
            execution_id=ExecutionContext.from_airflow_context(ctx).execution_id,
            error=str(ctx.get("exception", "Unknown error")),
        ),
        provide_context=True,
        trigger_rule=TriggerRule.ONE_FAILED,
    )

    # ─────────────────────────────────────────────────────────────────────────
    # TASK DEPENDENCIES
    # ─────────────────────────────────────────────────────────────────────────

    # Control plane flow
    start >> generate_plan >> source_check

    # Source check branching
    source_check >> [parse_group, skip_pipeline]

    # Contract gate
    parse_group >> contract_check
    contract_check >> [feeds_group, skip_pipeline]

    # Data plane flow
    feeds_group >> health_scores >> update_metadata >> end_success

    # Error handling
    [parse_group, feeds_group] >> end_failure
