# ═══════════════════════════════════════════════════════════════════════════════
# CONTROL PLANE FUNCTIONS (Decision Logic - NOT in Spark Jobs)
# ═══════════════════════════════════════════════════════════════════════════════

def generate_execution_plan(**context) -> Dict[str, Any]:
    """
    CONTROL PLANE: Generate ResolvedExecutionPlan for each feed in the group.
    Returns dict of feed_id -> execution_plan for parallel processing.
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    audit.log_event(
        "PLAN_GENERATION_STARTED",
        feed_group_id=FEED_GROUP_ID,
        execution_id=exec_ctx.execution_id,
    )

    # Load group metadata from PostgreSQL
    platform_feed_group = metadata.get_feed_group(FEED_GROUP_ID)
    feeds = metadata.get_feeds_by_group(FEED_GROUP_ID)

    execution_plans = {}

    for feed in feeds:
        # Load feed-specific metadata
        contract_metadata = metadata.get_contract_metadata(feed.contract_id)
        schema_metadata = metadata.get_schema(feed.schema_id)
        feed_config = INPUTPARAM[FEED_GROUP_ID]["feeds"].get(feed.feed_id, {})

        # Build execution plan for this feed
        execution_plan = {
            "plan_id": f"{exec_ctx.execution_id}_{feed.feed_id}",
            "feed_group_id": FEED_GROUP_ID,
            "feed_id": feed.feed_id,
            "batch_id": exec_ctx.batch_id,
            "dag_run_id": context["run_id"],
            "pattern_code": PATTERN_CODE,

            # Legacy source configuration
            "source": {
                "source_type": LEGACY_SOURCE_TYPE,
                {% if legacy_source_type == 'dtsx' %}
                "dtsx_path": "{{ dtsx_path }}",
                "connection_mappings": {{ connection_mappings | default({}) | tojson }},
                {% elif legacy_source_type == 'ebcdic' %}
                "copybook_path": "{{ copybook_path }}",
                "data_path": "{{ ebcdic_data_path }}",
                "encoding": "{{ encoding | default('cp037') }}",
                {% elif legacy_source_type == 'fixed_width' %}
                "layout_file": "{{ layout_file }}",
                "data_path": "{{ fixed_width_data_path }}",
                "record_length": {{ record_length | default(0) }},
                {% elif legacy_source_type == 'cobol' %}
                "copybook_path": "{{ copybook_path }}",
                "data_path": "{{ cobol_data_path }}",
                {% endif %}
            },

            # Schema snapshot
            "schema": schema_metadata,

            # Data Vault configuration (if applicable)
            {% if feed_config.get('data_vault_type') %}
            "data_vault_type": feed_config["data_vault_type"],
            {% endif %}

            # Zone configurations
            "zones": feed_config.get("zones", {}),

            # Great Expectations configuration
            "ge_config": {
                "suite_name": feed_config.get("ge_suite_name"),
                "quality_threshold": feed_config.get("quality_threshold", 0.95),
                "expectations_by_zone": {
                    "raw": contract_metadata.get("raw_expectations", []),
                    "silver": contract_metadata.get("silver_expectations", []),
                    "gold": contract_metadata.get("gold_expectations", []),
                },
            },

            # Transformations
            "transformations": contract_metadata.get("transformations", []),

            # Execution context
            "metadata_db_url": config.metadata_db_url,
            "execution_id": exec_ctx.execution_id,
            "schema_evolution_mode": "{{ schema_evolution_mode | default('strict') }}",
        }

        execution_plans[feed.feed_id] = execution_plan

        # Persist individual plan
        metadata.save_execution_plan(execution_plan["plan_id"], execution_plan)

    audit.log_event(
        "PLAN_GENERATION_COMPLETED",
        feed_group_id=FEED_GROUP_ID,
        feed_count=len(execution_plans),
        execution_id=exec_ctx.execution_id,
    )

    return execution_plans


def check_source_availability(**context) -> str:
    """
    Check if legacy source files/connections are available.
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    audit.log_event(
        "SOURCE_CHECK_STARTED",
        feed_group_id=FEED_GROUP_ID,
        source_type=LEGACY_SOURCE_TYPE,
    )

    {% if legacy_source_type == 'dtsx' %}
    # Validate DTSX package exists and is parseable
    parser = DTSXParser()
    if not parser.validate_package("{{ dtsx_path }}"):
        audit.log_event("SOURCE_CHECK_FAILED", reason="DTSX package invalid")
        return "skip_pipeline"
    {% elif legacy_source_type == 'ebcdic' %}
    # Validate copybook and data files exist
    if not COBOLCopybookParser.validate("{{ copybook_path }}"):
        audit.log_event("SOURCE_CHECK_FAILED", reason="Copybook invalid")
        return "skip_pipeline"
    {% elif legacy_source_type == 'fixed_width' %}
    # Validate layout file
    if not FixedWidthParser.validate_layout("{{ layout_file }}"):
        audit.log_event("SOURCE_CHECK_FAILED", reason="Layout file invalid")
        return "skip_pipeline"
    {% endif %}

    audit.log_event("SOURCE_CHECK_PASSED", feed_group_id=FEED_GROUP_ID)
    return "parse_legacy_source"


def check_contract_gate(**context) -> str:
    """
    CONTRACT GATE: Validate all feed contracts before processing.
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    ti = context["ti"]
    execution_plans = ti.xcom_pull(task_ids="generate_execution_plan")

    all_valid = True
    violations = []

    for feed_id, plan in execution_plans.items():
        result = contract_gate.validate_contract(
            feed_id=feed_id,
            execution_plan=plan,
            policy="{{ contract_policy | default('FAIL_FAST') }}",
        )

        if not result.is_valid:
            all_valid = False
            violations.extend(result.violations)

    if not all_valid:
        audit.log_event(
            "CONTRACT_CHECK_FAILED",
            feed_group_id=FEED_GROUP_ID,
            violations=violations,
        )

        if "{{ contract_policy | default('FAIL_FAST') }}" == "FAIL_FAST":
            raise ValueError(f"Contract validation failed: {violations}")
        return "skip_pipeline"

    audit.log_event("CONTRACT_CHECK_PASSED", feed_group_id=FEED_GROUP_ID)
    return "process_feeds"


def run_ge_validation(zone: str, feed_id: int, **context) -> Dict[str, Any]:
    """
    Run Great Expectations validation for a specific feed and zone.
    """
    ti = context["ti"]
    execution_plans = ti.xcom_pull(task_ids="generate_execution_plan")
    plan = execution_plans[feed_id]

    ge_config = plan.get("ge_config", {})
    suite_name = f"{ge_config.get('suite_name')}_{zone}"
    expectations = ge_config.get("expectations_by_zone", {}).get(zone, [])

    if not expectations:
        return {"status": "skipped", "reason": "No expectations defined"}

    # Run Great Expectations
    result = run_great_expectations(
        feed_id=feed_id,
        zone=zone,
        suite_name=suite_name,
        expectations=expectations,
        metadata_client=metadata,
    )

    # Check threshold
    quality_threshold = ge_config.get("quality_threshold", 0.95)
    if result.get("success_rate", 0) < quality_threshold:
        audit.log_event(
            "GE_VALIDATION_FAILED",
            feed_id=feed_id,
            zone=zone,
            success_rate=result.get("success_rate"),
            threshold=quality_threshold,
        )
        raise ValueError(
            f"GE validation failed for feed {feed_id} in {zone}: "
            f"{result.get('success_rate'):.2%} < {quality_threshold:.2%}"
        )

    return result


def calculate_health_score(**context) -> Dict[int, Dict[str, Any]]:
    """
    Calculate health scores for all feeds in the group.
    """
    exec_ctx = ExecutionContext.from_airflow_context(context)
    ti = context["ti"]

    health_scores = {}
    feeds = metadata.get_feeds_by_group(FEED_GROUP_ID)

    for feed in feeds:
        metrics = ti.xcom_pull(task_ids=f"collect_metrics_{feed.feed_id}") or {}

        health_score = health_calculator.calculate(
            feed_id=feed.feed_id,
            execution_id=exec_ctx.execution_id,
            metrics=metrics,
            weights={
                "quality": 0.4,
                "freshness": 0.3,
                "stability": 0.2,
                "cost_efficiency": 0.1,
            }
        )

        metadata.save_health_score(feed.feed_id, exec_ctx.execution_id, health_score)
        health_scores[feed.feed_id] = health_score.to_dict()

    return health_scores


