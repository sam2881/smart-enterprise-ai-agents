-- =============================================================================
-- INSERT PIPELINE METADATA
-- Generated for: {{ dag_id }}
-- Generated at: {{ generated_at | default('NOW()') }}
-- Jira Ticket: {{ jira_ticket | default('N/A') }}
-- =============================================================================
-- This template is used when:
--   1. New pipeline is onboarded
--   2. New source is introduced
--   3. First schema version is registered
-- =============================================================================

-- Transaction ensures atomic insert of all pipeline components
BEGIN;

-- -----------------------------------------------------------------------------
-- 1. PIPELINE REGISTRY (Master record)
-- -----------------------------------------------------------------------------
INSERT INTO pipeline_registry (
    dag_id,
    pipeline_name,
    domain,
    subdomain,
    product_code,
    description,
    owner_team,
    owner_email,
    jira_ticket,
    jira_epic,
    environment,
    status,
    version
) VALUES (
    '{{ dag_id }}',
    '{{ pipeline_name }}',
    '{{ domain }}',
    {{ "'" ~ subdomain ~ "'" if subdomain else 'NULL' }},
    '{{ product_code }}',
    {{ "'" ~ description | replace("'", "''") ~ "'" if description else 'NULL' }},
    '{{ owner_team }}',
    '{{ owner_email }}',
    {{ "'" ~ jira_ticket ~ "'" if jira_ticket else 'NULL' }},
    {{ "'" ~ jira_epic ~ "'" if jira_epic else 'NULL' }},
    '{{ environment | default("dev") }}',
    '{{ status | default("active") }}',
    '{{ version | default("1.0.0") }}'
)
ON CONFLICT (dag_id, environment) DO UPDATE SET
    pipeline_name = EXCLUDED.pipeline_name,
    domain = EXCLUDED.domain,
    subdomain = EXCLUDED.subdomain,
    product_code = EXCLUDED.product_code,
    description = EXCLUDED.description,
    owner_team = EXCLUDED.owner_team,
    owner_email = EXCLUDED.owner_email,
    jira_ticket = EXCLUDED.jira_ticket,
    updated_at = NOW()
RETURNING pipeline_id;

-- Store pipeline_id for subsequent inserts
-- In practice, use SELECT pipeline_id FROM pipeline_registry WHERE dag_id = '{{ dag_id }}' AND environment = '{{ environment }}'

-- -----------------------------------------------------------------------------
-- 2. SOURCE CONFIGURATION
-- -----------------------------------------------------------------------------
{% if source %}
INSERT INTO pipeline_sources (
    pipeline_id,
    source_type,
    source_format,
    {% if source.source_type.startswith('file_') %}
    source_bucket,
    source_prefix,
    file_pattern,
    delimiter,
    has_header,
    encoding,
    {% elif source.source_type.startswith('database_') %}
    connection_id,
    source_schema,
    source_table,
    source_query,
    extraction_mode,
    watermark_column,
    {% elif source.source_type.startswith('streaming_') %}
    kafka_bootstrap_servers,
    kafka_topic,
    kafka_consumer_group,
    pubsub_subscription,
    {% elif source.source_type.startswith('api_') %}
    api_endpoint,
    api_method,
    api_headers,
    api_pagination_type,
    {% elif source.source_type == 'dtsx' %}
    dtsx_location,
    dtsx_package_name,
    original_server,
    {% endif %}
    {% if source.field_specs %}field_specs,{% endif %}
    {% if source.copybook %}copybook,{% endif %}
    {% if source.record_length %}record_length,{% endif %}
    created_at
)
SELECT
    pipeline_id,
    '{{ source.source_type }}',
    {{ "'" ~ source.source_format ~ "'" if source.source_format else 'NULL' }},
    {% if source.source_type.startswith('file_') %}
    '{{ source.source_bucket }}',
    '{{ source.source_prefix }}',
    '{{ source.file_pattern | default("*") }}',
    '{{ source.delimiter | default(",") }}',
    {{ source.has_header | default(true) | lower }},
    '{{ source.encoding | default("utf-8") }}',
    {% elif source.source_type.startswith('database_') %}
    '{{ source.connection_id }}',
    {{ "'" ~ source.source_schema ~ "'" if source.source_schema else 'NULL' }},
    {{ "'" ~ source.source_table ~ "'" if source.source_table else 'NULL' }},
    {{ "'" ~ source.source_query | replace("'", "''") ~ "'" if source.source_query else 'NULL' }},
    '{{ source.extraction_mode | default("full") }}',
    {{ "'" ~ source.watermark_column ~ "'" if source.watermark_column else 'NULL' }},
    {% elif source.source_type.startswith('streaming_') %}
    {{ "'" ~ source.kafka_bootstrap_servers ~ "'" if source.kafka_bootstrap_servers else 'NULL' }},
    {{ "'" ~ source.kafka_topic ~ "'" if source.kafka_topic else 'NULL' }},
    {{ "'" ~ source.kafka_consumer_group ~ "'" if source.kafka_consumer_group else 'NULL' }},
    {{ "'" ~ source.pubsub_subscription ~ "'" if source.pubsub_subscription else 'NULL' }},
    {% elif source.source_type.startswith('api_') %}
    '{{ source.api_endpoint }}',
    '{{ source.api_method | default("GET") }}',
    '{{ source.api_headers | default({}) | tojson }}'::jsonb,
    {{ "'" ~ source.api_pagination_type ~ "'" if source.api_pagination_type else 'NULL' }},
    {% elif source.source_type == 'dtsx' %}
    '{{ source.dtsx_location }}',
    {{ "'" ~ source.dtsx_package_name ~ "'" if source.dtsx_package_name else 'NULL' }},
    {{ "'" ~ source.original_server ~ "'" if source.original_server else 'NULL' }},
    {% endif %}
    {% if source.field_specs %}'{{ source.field_specs | tojson }}'::jsonb,{% endif %}
    {% if source.copybook %}'{{ source.copybook | tojson }}'::jsonb,{% endif %}
    {% if source.record_length %}{{ source.record_length }},{% endif %}
    NOW()
FROM pipeline_registry
WHERE dag_id = '{{ dag_id }}' AND environment = '{{ environment | default("dev") }}'
ON CONFLICT (pipeline_id) DO UPDATE SET
    source_type = EXCLUDED.source_type,
    source_format = EXCLUDED.source_format,
    updated_at = NOW();
{% endif %}

-- -----------------------------------------------------------------------------
-- 3. SCHEMA DEFINITION (Version 1)
-- -----------------------------------------------------------------------------
{% if schema and schema.columns %}
-- Mark any existing schema as not current
UPDATE pipeline_schemas
SET is_current = FALSE, updated_at = NOW()
WHERE pipeline_id = (SELECT pipeline_id FROM pipeline_registry WHERE dag_id = '{{ dag_id }}' AND environment = '{{ environment | default("dev") }}')
  AND is_current = TRUE;

INSERT INTO pipeline_schemas (
    pipeline_id,
    schema_version,
    is_current,
    columns,
    primary_keys,
    partition_columns,
    cluster_columns
)
SELECT
    pipeline_id,
    {{ schema.schema_version | default(1) }},
    TRUE,
    '{{ schema.columns | tojson }}'::jsonb,
    {{ "'" ~ schema.primary_keys | tojson ~ "'::jsonb" if schema.primary_keys else "'[]'::jsonb" }},
    {{ "'" ~ schema.partition_columns | tojson ~ "'::jsonb" if schema.partition_columns else "'[]'::jsonb" }},
    {{ "'" ~ schema.cluster_columns | tojson ~ "'::jsonb" if schema.cluster_columns else "'[]'::jsonb" }}
FROM pipeline_registry
WHERE dag_id = '{{ dag_id }}' AND environment = '{{ environment | default("dev") }}';
{% endif %}

-- -----------------------------------------------------------------------------
-- 4. TARGET CONFIGURATION
-- -----------------------------------------------------------------------------
{% if target %}
INSERT INTO pipeline_targets (
    pipeline_id,
    target_zone,
    bq_project,
    bq_dataset,
    bq_table,
    bq_location,
    write_mode,
    merge_keys,
    partition_field,
    cluster_fields,
    destination_model
)
SELECT
    pipeline_id,
    '{{ target.target_zone | default("bronze") }}',
    {{ "'" ~ target.bq_project ~ "'" if target.bq_project else 'NULL' }},
    '{{ target.bq_dataset }}',
    '{{ target.bq_table }}',
    '{{ target.bq_location | default("US") }}',
    '{{ target.write_mode | default("append") }}',
    {{ "'" ~ target.merge_keys | tojson ~ "'::jsonb" if target.merge_keys else "'[]'::jsonb" }},
    {{ "'" ~ target.partition_field ~ "'" if target.partition_field else 'NULL' }},
    {{ "'" ~ target.cluster_fields | tojson ~ "'::jsonb" if target.cluster_fields else "'[]'::jsonb" }},
    '{{ target.destination_model | default("flat") }}'
FROM pipeline_registry
WHERE dag_id = '{{ dag_id }}' AND environment = '{{ environment | default("dev") }}'
ON CONFLICT (pipeline_id) DO UPDATE SET
    target_zone = EXCLUDED.target_zone,
    bq_dataset = EXCLUDED.bq_dataset,
    bq_table = EXCLUDED.bq_table,
    write_mode = EXCLUDED.write_mode,
    updated_at = NOW();
{% endif %}

-- -----------------------------------------------------------------------------
-- 5. TRANSFORMATION RULES
-- -----------------------------------------------------------------------------
{% if transformations %}
{% for transform in transformations %}
INSERT INTO transformation_rules (
    pipeline_id,
    rule_name,
    layer,
    execution_order,
    rule_type,
    input_format,
    source_columns,
    target_column,
    structured_config,
    sql_expression,
    nl_description,
    generated_pyspark,
    is_active,
    created_by
)
SELECT
    pipeline_id,
    '{{ transform.rule_name | default("transform_" ~ loop.index) }}',
    '{{ transform.layer | default("silver") }}',
    {{ transform.execution_order | default(loop.index) }},
    '{{ transform.rule_type }}',
    '{{ transform.input_format | default("structured") }}',
    '{{ transform.source_columns | default([]) | tojson }}'::jsonb,
    {{ "'" ~ transform.target_column ~ "'" if transform.target_column else 'NULL' }},
    {{ "'" ~ transform.structured_config | tojson ~ "'::jsonb" if transform.structured_config else 'NULL' }},
    {{ "'" ~ transform.sql_expression | replace("'", "''") ~ "'" if transform.sql_expression else 'NULL' }},
    {{ "'" ~ transform.nl_description | replace("'", "''") ~ "'" if transform.nl_description else 'NULL' }},
    {{ "'" ~ transform.generated_pyspark | replace("'", "''") ~ "'" if transform.generated_pyspark else 'NULL' }},
    TRUE,
    '{{ created_by | default("system") }}'
FROM pipeline_registry
WHERE dag_id = '{{ dag_id }}' AND environment = '{{ environment | default("dev") }}';

{% endfor %}
{% endif %}

-- -----------------------------------------------------------------------------
-- 6. QUALITY RULES
-- -----------------------------------------------------------------------------
{% if quality_rules %}
{% for rule in quality_rules %}
INSERT INTO pipeline_quality_rules (
    pipeline_id,
    rule_name,
    rule_type,
    column_name,
    config,
    severity,
    threshold_pct,
    is_active
)
SELECT
    pipeline_id,
    '{{ rule.rule_name }}',
    '{{ rule.rule_type }}',
    {{ "'" ~ rule.column_name ~ "'" if rule.column_name else 'NULL' }},
    '{{ rule.config | default({}) | tojson }}'::jsonb,
    '{{ rule.severity | default("warning") }}',
    {{ rule.threshold_pct | default(100.0) }},
    TRUE
FROM pipeline_registry
WHERE dag_id = '{{ dag_id }}' AND environment = '{{ environment | default("dev") }}';

{% endfor %}
{% endif %}

-- -----------------------------------------------------------------------------
-- 7. EXECUTION POLICY
-- -----------------------------------------------------------------------------
{% if execution_policy %}
INSERT INTO pipeline_execution_policies (
    pipeline_id,
    schedule_interval,
    start_date,
    end_date,
    catchup,
    processing_mode,
    max_active_runs,
    retry_count,
    retry_delay_minutes,
    sla_seconds,
    requires_human_approval,
    approval_groups,
    alert_emails
)
SELECT
    pipeline_id,
    '{{ execution_policy.schedule_interval | default("@daily") }}',
    {{ "'" ~ execution_policy.start_date ~ "'" if execution_policy.start_date else 'CURRENT_DATE' }},
    {{ "'" ~ execution_policy.end_date ~ "'" if execution_policy.end_date else 'NULL' }},
    {{ execution_policy.catchup | default(false) | lower }},
    '{{ execution_policy.processing_mode | default("batch") }}',
    {{ execution_policy.max_active_runs | default(1) }},
    {{ execution_policy.retry_count | default(2) }},
    {{ execution_policy.retry_delay_minutes | default(5) }},
    {{ execution_policy.sla_seconds | default('NULL') }},
    {{ execution_policy.requires_human_approval | default(false) | lower }},
    '{{ execution_policy.approval_groups | default([]) | tojson }}'::jsonb,
    '{{ execution_policy.alert_emails | default([]) | tojson }}'::jsonb
FROM pipeline_registry
WHERE dag_id = '{{ dag_id }}' AND environment = '{{ environment | default("dev") }}'
ON CONFLICT (pipeline_id) DO UPDATE SET
    schedule_interval = EXCLUDED.schedule_interval,
    processing_mode = EXCLUDED.processing_mode,
    retry_count = EXCLUDED.retry_count,
    updated_at = NOW();
{% endif %}

-- -----------------------------------------------------------------------------
-- 8. DATA CONTRACT (SLA Definition)
-- -----------------------------------------------------------------------------
{% if data_contract %}
INSERT INTO data_contracts (
    pipeline_id,
    contract_name,
    contract_version,
    freshness_sla_hours,
    completeness_threshold_pct,
    quality_score_min,
    owner_team,
    status
)
SELECT
    pipeline_id,
    '{{ dag_id }}_contract',
    '1.0.0',
    {{ data_contract.freshness_sla_hours | default(24) }},
    {{ data_contract.completeness_threshold_pct | default(99.0) }},
    {{ data_contract.quality_score_min | default(95.0) }},
    '{{ owner_team }}',
    'active'
FROM pipeline_registry
WHERE dag_id = '{{ dag_id }}' AND environment = '{{ environment | default("dev") }}'
ON CONFLICT (pipeline_id, contract_version) DO NOTHING;
{% endif %}

-- -----------------------------------------------------------------------------
-- 9. LOG PIPELINE EVENT
-- -----------------------------------------------------------------------------
INSERT INTO pipeline_events (
    dag_id,
    event_type,
    event_data,
    jira_ticket,
    environment
)
VALUES (
    '{{ dag_id }}',
    'pipeline_created',
    '{
        "action": "insert",
        "source_type": "{{ source.source_type if source else 'unknown' }}",
        "target_zone": "{{ target.target_zone if target else 'unknown' }}",
        "schema_version": {{ schema.schema_version | default(1) if schema else 1 }},
        "transformation_count": {{ transformations | length if transformations else 0 }},
        "quality_rule_count": {{ quality_rules | length if quality_rules else 0 }},
        "created_by": "{{ created_by | default('system') }}"
    }'::jsonb,
    {{ "'" ~ jira_ticket ~ "'" if jira_ticket else 'NULL' }},
    '{{ environment | default("dev") }}'
);

COMMIT;

-- =============================================================================
-- END OF INSERT METADATA
-- =============================================================================
