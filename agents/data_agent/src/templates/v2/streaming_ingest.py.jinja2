"""
APEX Data Agent - Streaming Ingest Pipeline (v2)
Pattern: Kafka/PubSub/Kinesis → Landing → Bronze → Silver → Gold

Generated by APEX Data Agent (deterministic)
Feed Group: {{ feed_group_id }}
DAG ID: {{ dag_id }}
Domain: {{ domain }}
"""

import os
from datetime import datetime, timedelta

from airflow import DAG
from airflow.operators.python import PythonOperator, BranchPythonOperator
from airflow.operators.empty import EmptyOperator
from airflow.utils.trigger_rule import TriggerRule
from airflow.utils.task_group import TaskGroup
{% if enable_self_retrigger %}
from airflow.operators.trigger_dagrun import TriggerDagRunOperator
{% endif %}
{% if dependencies %}
from airflow.sensors.external_task import ExternalTaskSensor
{% endif %}

from dag_utilities.core import MetadataClient, ExecutionContext, APEXConfig
from dag_utilities.pipeline import pipeline_tasks
from dag_utilities.sources.streaming_source import (
    consume_streaming_batch,
    get_consumer_offsets,
    commit_consumer_offsets,
)
from dag_utilities.common.zone_transition import submit_dataproc_job
from dag_utilities.common.sql_executor import run_bq_query
from dag_utilities.validation import SchemaValidator, SemanticValidator
from dag_utilities.notification import EmailNotifier
from dag_utilities.logging import AuditLogger
from dag_utilities.remediation import SelfHealer, RetryHandler


# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

FEED_GROUP_ID = "{{ feed_group_id }}"
DAG_ID = "{{ dag_id }}"
DOMAIN = "{{ domain }}"
ENVIRONMENT = os.getenv("APEX_ENVIRONMENT", "dev")

config = APEXConfig.from_environment()
metadata = MetadataClient(config.metadata_db_url)
retry_handler = RetryHandler(max_retries={{ retry_count | default(3) }})
audit = AuditLogger(metadata)

# Per-environment schedule
SCHEDULES = {{ schedule | tojson }}
SCHEDULE = SCHEDULES.get(ENVIRONMENT, "{{ schedule.get('dev', '*/15 * * * *') }}")

# Per-environment notifications
NOTIFICATIONS = {{ notification_emails | tojson }}
NOTIFY_EMAILS = NOTIFICATIONS.get(ENVIRONMENT, [])

default_args = {
    "owner": "{{ owner | default('apex-data-agent') }}",
    "depends_on_past": {{ depends_on_past | default(False) }},
    "email": NOTIFY_EMAILS,
    "email_on_failure": True,
    **retry_handler.get_airflow_retry_args(),
}


# ═══════════════════════════════════════════════════════════════════════════════
# DAG DEFINITION
# ═══════════════════════════════════════════════════════════════════════════════

with DAG(
    dag_id=DAG_ID,
    default_args=default_args,
    description="{{ description | default('Streaming Ingest Pipeline - ' ~ dag_id) }}",
    schedule_interval=SCHEDULE,
    start_date=datetime({{ start_year }}, {{ start_month }}, {{ start_day }}),
    catchup={{ catchup | default(False) }},
    max_active_runs={{ max_active_runs | default(1) }},
    tags=["apex", "v2", "streaming", "{{ domain }}"{% for tag in tags %}, "{{ tag }}"{% endfor %}],
) as dag:

    start = EmptyOperator(task_id="start")

    init_exec = PythonOperator(
        task_id="initialize_execution",
        python_callable=pipeline_tasks.initialize_execution,
        op_kwargs={
            "metadata": metadata,
            "feed_group_id": FEED_GROUP_ID,
            "execution_mode": "STREAMING_INGEST",
        },
    )

{% if dependencies %}
    # ═══════════════════════════════════════════════════════════════════════
    # UPSTREAM DEPENDENCIES
    # ═══════════════════════════════════════════════════════════════════════
{% for dep in dependencies %}
    wait_{{ dep.upstream_dag_id | replace("-", "_") }} = ExternalTaskSensor(
        task_id="wait_{{ dep.upstream_dag_id | replace('-', '_') }}",
        external_dag_id="{{ dep.upstream_dag_id }}",
        external_task_id="{{ dep.upstream_task_id | default('finalize') }}",
        timeout={{ dep.timeout_seconds | default(3600) }},
        poke_interval={{ dep.poke_interval | default(300) }},
        mode="reschedule",
        allowed_states=["success"],
    )
{% endfor %}
{% endif %}

    # ═══════════════════════════════════════════════════════════════════════
    # FEED TASK GROUPS
    # ═══════════════════════════════════════════════════════════════════════
{% for feed in feeds %}

    with TaskGroup(group_id="feed_{{ feed.feed_name }}") as tg_{{ feed.feed_name }}:

        # --- Get Consumer Offsets (checkpoint) ---
        get_offsets = PythonOperator(
            task_id="get_consumer_offsets",
            python_callable=get_consumer_offsets,
            op_kwargs={
                "metadata": metadata,
                "feed_id": "{{ feed.feed_id }}",
                "consumer_group": "{{ feed.source_config.consumer_group }}",
                "topic": "{{ feed.source_config.topic }}",
            },
        )

        # --- Consume Streaming Batch ---
        consume_batch = PythonOperator(
            task_id="consume_streaming_batch",
            python_callable=consume_streaming_batch,
            op_kwargs={
                "source_type": "{{ feed.source_config.streaming_type | default('kafka') }}",
                "topic": "{{ feed.source_config.topic }}",
                "bootstrap_servers": "{{ feed.source_config.bootstrap_servers | default('') }}",
                "consumer_group": "{{ feed.source_config.consumer_group }}",
                "batch_size": {{ feed.source_config.batch_size | default(10000) }},
                "batch_timeout_seconds": {{ feed.source_config.batch_timeout_seconds | default(300) }},
                "output_path": "gs://{{ config_bronze_bucket | default('datalake') }}/landing/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/{% raw %}{{ ts_nodash }}{% endraw %}/",
                "output_format": "{{ feed.source_config.output_format | default('parquet') }}",
{% if feed.source_config.window_duration %}
                "window_duration": "{{ feed.source_config.window_duration }}",
                "window_slide": "{{ feed.source_config.window_slide | default(feed.source_config.window_duration) }}",
{% endif %}
{% if feed.source_config.schema_registry_url %}
                "schema_registry_url": "{{ feed.source_config.schema_registry_url }}",
                "deserializer": "{{ feed.source_config.deserializer | default('avro') }}",
{% endif %}
            },
            execution_timeout=timedelta(minutes={{ feed.source_config.execution_timeout_minutes | default(30) }}),
            on_failure_callback=SelfHealer().on_task_failure,
        )

        # --- Source to Landing ---
        source_to_landing = PythonOperator(
            task_id="source_to_landing",
            python_callable=submit_dataproc_job,
            op_kwargs={
                "job_name": "source_to_landing",
                "job_path": "spark_jobs/v2/source_to_landing.py",
                "args": {
                    "--feed-id": "{{ feed.feed_id }}",
                    "--batch-id": "{% raw %}{{ ds_nodash }}_{{ ts_nodash }}{% endraw %}",
                    "--source-type": "streaming_batch",
                    "--source-path": "gs://{{ config_bronze_bucket | default('datalake') }}/landing/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/{% raw %}{{ ts_nodash }}{% endraw %}/",
                    "--target-path": "gs://{{ config_bronze_bucket | default('datalake') }}/landing/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/",
                    "--metadata-db": config.metadata_db_url,
                    "--file-format": "{{ feed.source_config.output_format | default('parquet') }}",
                },
            },
            on_failure_callback=SelfHealer().on_task_failure,
        )

        # --- Schema Validation ---
        schema_validation = BranchPythonOperator(
            task_id="schema_validation",
            python_callable=pipeline_tasks.run_ge_validation,
            op_kwargs={
                "config": config,
                "feed_id": "{{ feed.feed_id }}",
                "zone_level": "LANDING",
                "validation_type": "SCHEMA",
                "pass_task": "feed_{{ feed.feed_name }}.landing_to_bronze",
                "fail_task": "feed_{{ feed.feed_name }}.handle_validation_failure",
            },
        )

        # --- Landing to Bronze ---
        landing_to_bronze = PythonOperator(
            task_id="landing_to_bronze",
            python_callable=submit_dataproc_job,
            op_kwargs={
                "job_name": "landing_to_bronze",
                "job_path": "spark_jobs/v2/landing_to_bronze.py",
                "args": {
                    "--feed-id": "{{ feed.feed_id }}",
                    "--contract-id": "{{ feed.feed_id }}",
                    "--execution-id": "{% raw %}{{ ti.xcom_pull(key='execution_id') }}{% endraw %}",
                    "--execution-date": "{% raw %}{{ ds }}{% endraw %}",
                    "--metadata-db": config.metadata_db_url,
                    "--landing-path": "gs://{{ config_bronze_bucket | default('datalake') }}/landing/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/",
                    "--bronze-path": "gs://{{ config_bronze_bucket | default('datalake') }}/bronze/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/",
{% if feed.bq_target %}
                    "--bq-table": "{{ feed.bq_target.project | default('${GCP_PROJECT}') }}.bronze_{{ domain }}.{{ feed.bq_target.table }}",
{% endif %}
                },
            },
            on_failure_callback=SelfHealer().on_task_failure,
        )

        # --- Semantic Validation ---
        semantic_validation = BranchPythonOperator(
            task_id="semantic_validation",
            python_callable=pipeline_tasks.run_ge_validation,
            op_kwargs={
                "config": config,
                "feed_id": "{{ feed.feed_id }}",
                "zone_level": "BRONZE",
                "validation_type": "SEMANTIC",
                "pass_task": "feed_{{ feed.feed_name }}.bronze_to_silver",
                "fail_task": "feed_{{ feed.feed_name }}.handle_validation_failure",
            },
        )

        # --- Bronze to Silver ---
        bronze_to_silver = PythonOperator(
            task_id="bronze_to_silver",
            python_callable=submit_dataproc_job,
            op_kwargs={
                "job_name": "bronze_to_silver",
                "job_path": "spark_jobs/v2/bronze_to_silver.py",
                "args": {
                    "--feed-id": "{{ feed.feed_id }}",
                    "--contract-id": "{{ feed.feed_id }}",
                    "--execution-id": "{% raw %}{{ ti.xcom_pull(key='execution_id') }}{% endraw %}",
                    "--execution-date": "{% raw %}{{ ds }}{% endraw %}",
                    "--metadata-db": config.metadata_db_url,
                    "--bronze-path": "gs://{{ config_bronze_bucket | default('datalake') }}/bronze/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/",
                    "--silver-path": "gs://{{ config_silver_bucket | default('datalake') }}/silver/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/",
                    "--business-keys": "{{ feed.business_keys | join(',') }}",
{% if feed.watermark_column %}
                    "--watermark-column": "{{ feed.watermark_column }}",
{% endif %}
{% if feed.bq_target %}
                    "--bq-table": "{{ feed.bq_target.project | default('${GCP_PROJECT}') }}.silver_{{ domain }}.{{ feed.bq_target.table }}",
{% endif %}
                },
            },
            on_failure_callback=SelfHealer().on_task_failure,
        )

        # --- Silver to Gold ---
        silver_to_gold = PythonOperator(
            task_id="silver_to_gold",
            python_callable=submit_dataproc_job,
            op_kwargs={
                "job_name": "silver_to_gold",
                "job_path": "spark_jobs/v2/silver_to_gold.py",
                "args": {
                    "--feed-id": "{{ feed.feed_id }}",
                    "--contract-id": "{{ feed.feed_id }}",
                    "--execution-id": "{% raw %}{{ ti.xcom_pull(key='execution_id') }}{% endraw %}",
                    "--execution-date": "{% raw %}{{ ds }}{% endraw %}",
                    "--metadata-db": config.metadata_db_url,
                    "--silver-path": "gs://{{ config_silver_bucket | default('datalake') }}/silver/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/",
                    "--gold-path": "gs://{{ config_gold_bucket | default('datalake') }}/gold/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/",
                    "--model-type": "{{ feed.gold_model.model_type if feed.gold_model else 'flat' }}",
                    "--business-keys": "{{ feed.business_keys | join(',') }}",
{% if feed.bq_target %}
                    "--bq-table": "{{ feed.bq_target.project | default('${GCP_PROJECT}') }}.gold_{{ domain }}.{{ feed.bq_target.table }}",
{% endif %}
                },
            },
            on_failure_callback=SelfHealer().on_task_failure,
        )

        # --- Commit Consumer Offsets (checkpoint) ---
        commit_offsets = PythonOperator(
            task_id="commit_consumer_offsets",
            python_callable=commit_consumer_offsets,
            op_kwargs={
                "metadata": metadata,
                "feed_id": "{{ feed.feed_id }}",
                "consumer_group": "{{ feed.source_config.consumer_group }}",
                "topic": "{{ feed.source_config.topic }}",
            },
        )

{% if feed.gold_model and feed.gold_model.model_type == 'data_vault' %}
        # --- Data Vault Loaders ---
{% for hub in feed.gold_model.hubs %}
        load_hub_{{ hub.hub_name }} = PythonOperator(
            task_id="load_hub_{{ hub.hub_name }}",
            python_callable=submit_dataproc_job,
            op_kwargs={
                "job_name": "load_hub_{{ hub.hub_name }}",
                "job_path": "spark_jobs/v2/load_hub.py",
                "args": {
                    "--feed-id": "{{ feed.feed_id }}",
                    "--execution-id": "{% raw %}{{ ti.xcom_pull(key='execution_id') }}{% endraw %}",
                    "--metadata-db": config.metadata_db_url,
                    "--source-path": "gs://{{ config_silver_bucket | default('datalake') }}/silver/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/",
                    "--hub-name": "{{ hub.hub_name }}",
                    "--business-keys": "{{ hub.business_keys | join(',') }}",
                    "--target-table": "{{ hub.target_table }}",
                    "--bq-project": "{{ feed.bq_target.project | default('${GCP_PROJECT}') }}",
                },
            },
        )
{% endfor %}
{% for sat in feed.gold_model.satellites %}
        load_sat_{{ sat.satellite_name }} = PythonOperator(
            task_id="load_sat_{{ sat.satellite_name }}",
            python_callable=submit_dataproc_job,
            op_kwargs={
                "job_name": "load_sat_{{ sat.satellite_name }}",
                "job_path": "spark_jobs/v2/load_satellite.py",
                "args": {
                    "--feed-id": "{{ feed.feed_id }}",
                    "--execution-id": "{% raw %}{{ ti.xcom_pull(key='execution_id') }}{% endraw %}",
                    "--metadata-db": config.metadata_db_url,
                    "--source-path": "gs://{{ config_silver_bucket | default('datalake') }}/silver/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/",
                    "--satellite-name": "{{ sat.satellite_name }}",
                    "--hub-hash-key-col": "{{ sat.hub_reference }}_hash_key",
                    "--descriptive-columns": "{{ sat.descriptive_columns | join(',') }}",
                    "--target-table": "{{ sat.target_table }}",
                    "--bq-project": "{{ feed.bq_target.project | default('${GCP_PROJECT}') }}",
                },
            },
        )
{% endfor %}
{% endif %}

{% if feed.gold_model and feed.gold_model.model_type == 'star_schema' %}
        # --- Star Schema Loaders ---
{% for dim in feed.gold_model.dimensions %}
        load_dim_{{ dim.dimension_name }} = PythonOperator(
            task_id="load_dim_{{ dim.dimension_name }}",
            python_callable=submit_dataproc_job,
            op_kwargs={
                "job_name": "load_dim_{{ dim.dimension_name }}",
                "job_path": "spark_jobs/v2/load_dimension.py",
                "args": {
                    "--feed-id": "{{ feed.feed_id }}",
                    "--execution-id": "{% raw %}{{ ti.xcom_pull(key='execution_id') }}{% endraw %}",
                    "--metadata-db": config.metadata_db_url,
                    "--source-path": "gs://{{ config_silver_bucket | default('datalake') }}/silver/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/",
                    "--dimension-name": "{{ dim.dimension_name }}",
                    "--natural-key": "{{ dim.natural_key }}",
                    "--scd-type": "{{ dim.scd_type }}",
                    "--columns": "{{ dim.columns | join(',') }}",
                    "--target-table": "{{ dim.target_table }}",
                    "--bq-project": "{{ feed.bq_target.project | default('${GCP_PROJECT}') }}",
                },
            },
        )
{% endfor %}
{% for fact in feed.gold_model.facts %}
        load_fact_{{ fact.fact_name }} = PythonOperator(
            task_id="load_fact_{{ fact.fact_name }}",
            python_callable=submit_dataproc_job,
            op_kwargs={
                "job_name": "load_fact_{{ fact.fact_name }}",
                "job_path": "spark_jobs/v2/load_fact.py",
                "args": {
                    "--feed-id": "{{ feed.feed_id }}",
                    "--execution-id": "{% raw %}{{ ti.xcom_pull(key='execution_id') }}{% endraw %}",
                    "--execution-date": "{% raw %}{{ ds }}{% endraw %}",
                    "--metadata-db": config.metadata_db_url,
                    "--source-path": "gs://{{ config_silver_bucket | default('datalake') }}/silver/{{ domain }}/{{ feed.feed_name }}/{% raw %}{{ ds }}{% endraw %}/",
                    "--fact-name": "{{ fact.fact_name }}",
                    "--grain-columns": "{{ fact.grain_columns | join(',') }}",
                    "--measures-json": '{{ fact.measures | tojson }}',
                    "--dimension-lookups-json": '{{ fact.dimension_lookups | tojson }}',
                    "--target-table": "{{ fact.target_table }}",
                    "--bq-project": "{{ feed.bq_target.project | default('${GCP_PROJECT}') }}",
                },
            },
        )
{% endfor %}
{% endif %}

        # --- Audit ---
        audit_log = PythonOperator(
            task_id="audit_log",
            python_callable=pipeline_tasks.audit_execution,
            op_kwargs={
                "metadata": metadata,
                "feed_id": "{{ feed.feed_id }}",
            },
        )

        # --- Validation Failure Handler ---
        handle_validation_failure = PythonOperator(
            task_id="handle_validation_failure",
            python_callable=pipeline_tasks.handle_validation_failure,
            trigger_rule=TriggerRule.ONE_FAILED,
        )

        # --- Task Dependencies (within TaskGroup) ---
        get_offsets >> consume_batch >> source_to_landing >> schema_validation
        schema_validation >> landing_to_bronze >> semantic_validation
        semantic_validation >> bronze_to_silver >> silver_to_gold >> commit_offsets

{% if feed.gold_model and feed.gold_model.model_type == 'data_vault' %}
{% for hub in feed.gold_model.hubs %}
        commit_offsets >> load_hub_{{ hub.hub_name }}
{% endfor %}
{% for sat in feed.gold_model.satellites %}
        commit_offsets >> load_sat_{{ sat.satellite_name }}
{% endfor %}
{% for hub in feed.gold_model.hubs %}
        load_hub_{{ hub.hub_name }} >> audit_log
{% endfor %}
{% for sat in feed.gold_model.satellites %}
        load_sat_{{ sat.satellite_name }} >> audit_log
{% endfor %}
{% elif feed.gold_model and feed.gold_model.model_type == 'star_schema' %}
{% for dim in feed.gold_model.dimensions %}
        commit_offsets >> load_dim_{{ dim.dimension_name }}
{% endfor %}
{% for fact in feed.gold_model.facts %}
{% for dim in feed.gold_model.dimensions %}
        load_dim_{{ dim.dimension_name }} >> load_fact_{{ fact.fact_name }}
{% endfor %}
        load_fact_{{ fact.fact_name }} >> audit_log
{% endfor %}
{% else %}
        commit_offsets >> audit_log
{% endif %}

        schema_validation >> handle_validation_failure
        semantic_validation >> handle_validation_failure

{% endfor %}

{% if enable_duplicate_detection %}
    # ═══════════════════════════════════════════════════════════════════════
    # DUPLICATE DETECTION
    # ═══════════════════════════════════════════════════════════════════════
    check_duplicates = BranchPythonOperator(
        task_id="check_duplicates",
        python_callable=pipeline_tasks.check_duplicate_files,
        op_kwargs={"metadata": metadata, "feed_group_id": FEED_GROUP_ID},
    )
{% endif %}

{% if enable_self_retrigger %}
    # ═══════════════════════════════════════════════════════════════════════
    # SELF-RETRIGGER (remaining micro-batches)
    # ═══════════════════════════════════════════════════════════════════════
    check_remaining = BranchPythonOperator(
        task_id="check_remaining_messages",
        python_callable=pipeline_tasks.check_remaining_messages,
        op_kwargs={
            "metadata": metadata,
            "feed_group_id": FEED_GROUP_ID,
            "retrigger_task": "retrigger_dag",
            "done_task": "finalize",
        },
    )

    retrigger = TriggerDagRunOperator(
        task_id="retrigger_dag",
        trigger_dag_id=DAG_ID,
        wait_for_completion=False,
        reset_dag_run=True,
    )
{% endif %}

    # ═══════════════════════════════════════════════════════════════════════
    # FINALIZE & NOTIFY
    # ═══════════════════════════════════════════════════════════════════════
    finalize = PythonOperator(
        task_id="finalize",
        python_callable=pipeline_tasks.finalize_execution,
        op_kwargs={
            "metadata": metadata,
            "metric_keys": ["landing_metrics", "bronze_metrics", "silver_metrics", "gold_metrics"],
        },
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    notify = PythonOperator(
        task_id="send_notifications",
        python_callable=pipeline_tasks.send_notification,
        op_kwargs={
            "feed_group_id": FEED_GROUP_ID,
            "dag_id": DAG_ID,
            "emails": NOTIFY_EMAILS,
        },
        trigger_rule=TriggerRule.ALL_DONE,
    )

    end = EmptyOperator(
        task_id="end",
        trigger_rule=TriggerRule.ALL_DONE,
    )

    # ═══════════════════════════════════════════════════════════════════════
    # DAG-LEVEL DEPENDENCIES
    # ═══════════════════════════════════════════════════════════════════════
{% if dependencies %}
{% for dep in dependencies %}
    start >> wait_{{ dep.upstream_dag_id | replace("-", "_") }} >> init_exec
{% endfor %}
{% else %}
    start >> init_exec
{% endif %}

{% for feed in feeds %}
    init_exec >> tg_{{ feed.feed_name }}
    tg_{{ feed.feed_name }} >> finalize
{% endfor %}

{% if enable_self_retrigger %}
    finalize >> check_remaining
    check_remaining >> retrigger >> end
    check_remaining >> end
{% else %}
    finalize >> notify >> end
{% endif %}
