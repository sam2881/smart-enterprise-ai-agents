{
  "id": null,
  "uid": "data-pipeline",
  "title": "Data Pipeline Agent (APEX)",
  "tags": ["ai-agent", "data-engineering", "pipelines"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pipeline Runs (24h)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(pipeline_runs_total[24h])", "refId": "A"}],
      "options": {"colorMode": "background", "graphMode": "area"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Pipeline Runs",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "active_tasks", "refId": "A"}],
      "options": {"colorMode": "background"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Artifact Generation Success Rate",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(task_counter_total{status=\"success\"}[5m]) / rate(task_counter_total[5m]) * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Pipeline Status Distribution",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "pipeline_runs_total", "legendFormat": "{{status}}", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pipeline Generation Duration (P95)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, rate(task_execution_time_seconds_bucket[5m]))", "legendFormat": "P95 Duration", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM Token Usage",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(llm_tokens_total{type=\"prompt\"}[5m])", "legendFormat": "Prompt Tokens/s", "refId": "A"},
        {"expr": "rate(llm_tokens_total{type=\"completion\"}[5m])", "legendFormat": "Completion Tokens/s", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    }
  ]
}
