FROM python:3.11-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY agents/servicenow_agent/requirements.txt ./requirements-sn.txt
COPY backend/requirements.txt ./requirements-backend.txt
RUN pip install --no-cache-dir -r requirements-sn.txt -r requirements-backend.txt

COPY agents/servicenow_agent/ ./agents/servicenow_agent/
COPY backend/ ./backend/
COPY platform_services/ ./platform_services/

ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

CMD ["python", "-m", "agents.servicenow_agent.src.streaming.consumers.event_orchestrator"]
